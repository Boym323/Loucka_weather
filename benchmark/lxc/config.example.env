# Zkopiruj jako config.env: cp config.example.env config.env && chmod 600 config.env
# Pouze databazovy ucet s opravnenim SELECT. Neuvadej sem produkcni zapisovaci ucet WeeWX.
BENCH_DB_HOST='192.168.1.XX'
BENCH_DB_PORT='3306'
BENCH_DB_NAME='pocasi-loucka.eu'
BENCH_DB_USER='loucka_bench_ro'
