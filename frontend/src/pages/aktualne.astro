---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentPanel from '../features/current/CurrentPanel.astro';
import WindCompass from '../features/current/WindCompass.astro';
import OverviewReadings from '../features/current/OverviewReadings.astro';
import HistoryChart from '../features/history/HistoryChart.astro';
import SensorChannels from '../features/sensors/SensorChannels.astro';
---
<BaseLayout title="Aktuální údaje">
 <div class="page-intro actual-intro">
  <div><span class="eyebrow">GW3000 / WeeWX · poslední archivní záznam</span><h1>Aktuální údaje</h1><p>Detailní přehled současných meteorologických měření v Loučce.</p></div>
  <span class="status-chip">Archivní údaje · ne sekundový přenos</span>
 </div>
 <div class="actual-layout">
  <div class="actual-main">
   <CurrentPanel />
   <div class="actual-wind-row">
    <WindCompass />
    <HistoryChart compact defaultMetric="windGust" />
   </div>
  </div>
  <aside class="actual-side">
   <OverviewReadings />
   <section class="section">
    <div class="section-heading"><h2>Další archivní kanály</h2><a class="panel-link" href="/senzory/">Detail ↗</a></div>
    <p class="lead">Měření půdních a dalších externích kanálů jsou označena původními názvy WeeWX, dokud nebude potvrzeno jejich fyzické umístění.</p>
    <a href="/senzory/" class="panel-link">Přejít na přehled kanálů ↗</a>
   </section>
  </aside>
 </div>
 <SensorChannels />
</BaseLayout>
