---
interface Props { compact?: boolean; defaultMetric?: string; hero?: boolean }
const { compact = false, defaultMetric = 'outTemp', hero = false } = Astro.props;
const tabs = [
 { id:'outTemp',label:'Teplota' },
 { id:'outHumidity',label:'Vlhkost' },
 { id:'barometer',label:'Tlak' },
 { id:'windSpeed',label:'Vítr' },
 { id:'windGust',label:'Nárazy' },
 { id:'rainRate',label:'Srážky' }
];
---
<section class:list={['section',{'history-hero':hero}]} data-history-chart data-compact={compact ? 'true' : 'false'} data-hero={hero ? 'true' : 'false'} data-default-metric={defaultMetric} aria-labelledby={compact?'home-chart-title':'history-chart-title'}>
 <div class="section-heading">
  <div><span class="eyebrow">Vývoj počasí v čase</span><h2 id={compact?'home-chart-title':'history-chart-title'}>{hero?'Teplota · posledních 24 hodin':compact?(defaultMetric==='windGust'?'Nárazy větru · 24 hodin':'Posledních 24 hodin'):'Interaktivní meteorologický graf'}</h2></div>
  <span class="status-chip" data-chart-status role="status">Načítání grafu</span>
 </div>
 <div class="chart-toolbar" role="group" aria-label="Vybrat veličinu">
  {tabs.map(tab=><button class="chart-tab" data-select-metric={tab.id} type="button" aria-pressed={tab.id===defaultMetric?'true':'false'}>{tab.label}</button>)}
 </div>
 {!compact && <div class="chart-toolbar" role="group" aria-label="Časový rozsah" style="margin-top:10px">
  <span class="source-note">Období:</span>
  <button class="chart-tab" data-select-hours="6" aria-pressed="false" type="button">6 hodin</button>
  <button class="chart-tab" data-select-hours="24" aria-pressed="true" type="button">24 hodin</button>
  <button class="chart-tab" data-select-hours="72" aria-pressed="false" type="button">3 dny</button>
 </div>}
 <figure class="chart-figure">
  <div class:list={['chart-box',{'large':!compact}]} data-chart-canvas role="img" aria-label="Graf meteorologických měření v čase"></div>
  <figcaption class="chart-message" data-chart-message>Načítám průběh počasí…</figcaption>
  <button class="chart-retry" type="button" data-chart-retry hidden>Zkusit znovu</button>
 </figure>
 <div class="chart-summary" data-chart-summary aria-live="polite"></div>
 <p class="history-legend">Všechny časy jsou místní. Kde chybí měření, graf má mezeru.</p>
</section>
<script>
 import { getHistoryRange } from '../../shared/api/client';
 import { getMetric, formatValue } from '../../shared/domain/metrics';
 import type { HistoryResponse } from '../../shared/domain/weather';
 // Delay the large ECharts engine until the document is interactive.
 // No history value or endpoint is changed; the visible real chart still paints.
 const formatTime=(value:number)=>new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',hour:'2-digit',minute:'2-digit',day:'numeric',month:'numeric'}).format(new Date(value));
 const colorByMetric:Record<string,string>={outTemp:'#176878',outHumidity:'#386e96',barometer:'#665d83',windSpeed:'#27785e',windGust:'#27785e',rainRate:'#2879a3'};
 let departed=false;
 document.addEventListener('astro:before-swap',()=>{departed=true;},{once:true});
 // For mobile homepage only, avoid competing with the above-the-fold
 // camera/CSS critical path. Render immediately if the chart is in view;
 // otherwise import when near view, with a bounded fallback so the default
 // visible page still paints the authentic chart without user interaction.
 // The opt-in collapsed layout has no fallback until the chart is revealed.
 let visibilityGateInstalled=false,visibilityGateReleased=false;
 const start=()=>{
  const homeChart=document.querySelector<HTMLElement>('[data-history-chart][data-hero="true"]');
  if(!visibilityGateReleased&&homeChart&&
    window.matchMedia('(max-width:760px)').matches&&
    'IntersectionObserver' in window){
   if(visibilityGateInstalled)return;
   const nearTop=homeChart.getBoundingClientRect().top<=window.innerHeight-40;
   const isHiddenPreview=document.documentElement.dataset.mobileHomeVariant==='compact';
   if(!nearTop||isHiddenPreview){
    visibilityGateInstalled=true;
    let fallback:number|undefined;
    const observer=new IntersectionObserver(entries=>{
     if(entries.some(entry=>entry.isIntersecting))release();
    },{rootMargin:'0px 0px -40px 0px'});
    const release=()=>{
     if(visibilityGateReleased||departed)return;
     visibilityGateReleased=true;
     observer.disconnect();
     if(fallback!==undefined)window.clearTimeout(fallback);
     start();
    };
    observer.observe(homeChart);
    if(!isHiddenPreview)fallback=window.setTimeout(release,3500);
    document.addEventListener('astro:before-swap',()=>{
     observer.disconnect();
     if(fallback!==undefined)window.clearTimeout(fallback);
    },{once:true});
    return;
   }
  }
  void import('../../shared/charts/history-engine').then(({echarts})=>{
   if(departed)return;
   document.querySelectorAll<HTMLElement>('[data-history-chart]').forEach(root=>{
  const element=root.querySelector<HTMLElement>('[data-chart-canvas]');
  const message=root.querySelector<HTMLElement>('[data-chart-message]');
  const status=root.querySelector<HTMLElement>('[data-chart-status]');
  const summary=root.querySelector<HTMLElement>('[data-chart-summary]');
  const retry=root.querySelector<HTMLButtonElement>('[data-chart-retry]');
  const figure=root.querySelector<HTMLElement>('.chart-figure');
  if(!element)return;
  const chart=echarts.init(element,undefined,{renderer:'svg'});
  const observer=new ResizeObserver(()=>chart.resize());observer.observe(element);
  let controller:AbortController|undefined;
  let activeMetric=root.dataset.defaultMetric??'outTemp',hours=24;
  async function update(){
   controller?.abort();controller=new AbortController();const signal=controller.signal;
   if(status){status.textContent='Načítání…';status.className='status-chip';}
   if(retry)retry.hidden=true;
   if(figure)figure.dataset.chartState='loading';
   if(element)element.hidden=false;
   if(summary)summary.replaceChildren();
   if(message)message.textContent='Načítání archivních měření…';
   try{
    const result:HistoryResponse=await getHistoryRange(activeMetric,hours,signal);
    if(signal.aborted)return;
    const known=getMetric(activeMetric);
    if(!known)throw new Error('Nepodporovaná veličina');
    const plotted=result.points.map(point=>[
     Date.parse(point.endTime),
     point.value===null||point.quality==='missing'||point.quality==='suspect'?null:point.value
    ] as [number,number|null]);
    const valid=plotted.filter((point):point is [number,number]=>point[1]!==null&&Number.isFinite(point[1]));
    const light=document.documentElement.dataset.theme!=='dark';
    const compact=window.matchMedia('(max-width:650px)').matches;
    const axisColor=light?'#4b625e':'#bbd0cc';
    const gridColor=light?'#e2e9e6':'#3a5054';
    const shortTime=new Intl.DateTimeFormat('cs-CZ',{
     timeZone:'Europe/Prague',...(hours<=24?{hour:'2-digit',minute:'2-digit'}:{day:'numeric',month:'numeric'})
    });
    const darkColors:Record<string,string>={outTemp:'#8dd5c9',outHumidity:'#89bedb',barometer:'#bbacd5',
     windSpeed:'#8dd1b4',windGust:'#8dd1b4',rainRate:'#8dc7e4'};
    const color=light?(colorByMetric[activeMetric]??'#176878'):(darkColors[activeMetric]??'#8dd5c9');
    chart.clear();
    chart.setOption({
     backgroundColor:'transparent',
     animation:false,
     grid:{top:24,right:compact?10:18,bottom:compact?37:43,left:compact?43:49,containLabel:false},
     tooltip:{trigger:'axis',confine:true},
     xAxis:{type:'time',splitNumber:compact?3:7,
      axisLine:{lineStyle:{color:gridColor}},
      axisLabel:{color:axisColor,fontSize:compact?11:12,hideOverlap:true,showMinLabel:false,showMaxLabel:false,
       formatter:(value:number)=>compact?shortTime.format(new Date(value)):formatTime(value)},
      axisTick:{show:false},splitLine:{show:false}},
     yAxis:{type:'value',scale:true,splitNumber:4,name:known.unit,
      nameTextStyle:{color:axisColor,fontSize:11},
      axisLabel:{color:axisColor,fontSize:compact?11:12},
      axisLine:{show:false},axisTick:{show:false},
      splitLine:{lineStyle:{color:gridColor,type:'solid'}}},
     series:[{
      name:known.label,type:activeMetric==='rainRate'||activeMetric==='windGust'?'bar':'line',data:plotted,
      showSymbol:false,connectNulls:false,smooth:false,lineStyle:{width:2,color},
      itemStyle:{color},areaStyle:activeMetric==='rainRate'?undefined:{color,opacity:.13},
      barMaxWidth:16
     }]
    });
    if(status){status.textContent=valid.length+' naměřených bodů';status.className='status-chip '+(valid.length?'ok':'warning');}
    if(figure)figure.dataset.chartState=valid.length?'ready':'empty';
    if(element)element.hidden=!valid.length;
    if(message)message.textContent=valid.length?'Mezery označují chybějící měření.':'Pro vybraný rozsah nejsou dostupné platné údaje. Zkus jinou veličinu nebo období.';
    if(summary&&valid.length){
     const values=valid.map(point=>point[1]);
     const min=Math.min(...values),max=Math.max(...values);
     // Do not label min/max as calendar-day extrema; it is a sliding selected interval.
     const lowest=document.createElement('span');
     const highest=document.createElement('span');
     lowest.textContent='Minimum ('+hours+' h): '+formatValue(min,known.digits)+' '+known.unit;
     highest.textContent='Maximum ('+hours+' h): '+formatValue(max,known.digits)+' '+known.unit;
     summary.append(lowest,highest);
    }
    chart.resize();
   }catch(error){
    if(signal.aborted)return;
    chart.clear();
    if(status){status.textContent='Historie nedostupná';status.className='status-chip error';}
    if(figure)figure.dataset.chartState='error';
    if(element)element.hidden=true;
    if(retry)retry.hidden=false;
    if(message)message.textContent='Historická data se nepodařilo načíst. Můžeš zkusit opakovat požadavek.';
   }
  }
  retry?.addEventListener('click',()=>void update());
  root.querySelectorAll<HTMLButtonElement>('[data-select-metric]').forEach(btn=>btn.addEventListener('click',()=>{
   activeMetric=btn.dataset.selectMetric??'outTemp';
   root.querySelectorAll<HTMLButtonElement>('[data-select-metric]').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));
   void update();
  }));
  root.querySelectorAll<HTMLButtonElement>('[data-select-hours]').forEach(btn=>btn.addEventListener('click',()=>{
   hours=Number(btn.dataset.selectHours??'24');
   root.querySelectorAll<HTMLButtonElement>('[data-select-hours]').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));
   void update();
  }));
  document.addEventListener('astro:before-swap',()=>{
   controller?.abort();observer.disconnect();chart.dispose();
   window.removeEventListener('loucka:theme-change',themeChanged);
   window.removeEventListener('loucka:archive-updated',archiveChanged);
  },{once:true});
  const archiveChanged=()=>{if(!controller?.signal.aborted)void update();};
  window.addEventListener('loucka:archive-updated',archiveChanged);
  // Reuse the existing API route: switching theme also recolors the chart axes.
  const themeChanged=()=>{void update();};
  window.addEventListener('loucka:theme-change',themeChanged);
  void update();
   });
  }).catch(()=>{
   if(departed)return;
   document.querySelectorAll<HTMLElement>('[data-history-chart]').forEach(root=>{
    const status=root.querySelector<HTMLElement>('[data-chart-status]');
    const message=root.querySelector<HTMLElement>('[data-chart-message]');
    const retry=root.querySelector<HTMLButtonElement>('[data-chart-retry]');
    const figure=root.querySelector<HTMLElement>('.chart-figure');
    const canvas=root.querySelector<HTMLElement>('[data-chart-canvas]');
    if(status){status.textContent='Historie nedostupná';status.className='status-chip error';}
    if(figure)figure.dataset.chartState='error';
    if(canvas)canvas.hidden=true;
    if(retry){retry.hidden=false;retry.addEventListener('click',start,{once:true});}
    if(message)message.textContent='Graf se nepodařilo připravit. Můžeš to zkusit znovu.';
   });
  });
 };
 // Astro's module script is now small and never awaits ECharts before
 // DOMContentLoaded, so a slower chart chunk does not delay the page itself.
 if(document.readyState==='loading')
  document.addEventListener('DOMContentLoaded',start,{once:true});
 else start();
</script>
