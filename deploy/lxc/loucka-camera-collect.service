[Unit]
Description=Loucka camera - capture existing public JPEG into staging archive
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=loucka
Group=loucka
ExecStart=/usr/bin/python3 /usr/local/libexec/loucka-data-collector.py camera
StateDirectory=loucka-camera
StateDirectoryMode=0755
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/loucka-camera
TimeoutStartSec=180
