---
interface Props { variant?: 'default' | 'hero' }
const {variant='default'}=Astro.props;
---
<section class:list={['section','wind-compass-panel',{'wind-hero':variant==='hero'}]} data-wind-compass aria-labelledby="wind-compass-title">
 <div class="section-heading">
  <div><span class="eyebrow">Směr větru · anemometr</span><h2 id="wind-compass-title">Větrná růžice</h2></div>
  <span class="status-chip" data-wind-status role="status">Načítám</span>
 </div>
 <div class="wind-layout wind-layout-v2">
  <div class="wind-gauge wind-gauge-v2" data-wind-valid="false" role="img" aria-label="Směr větru není dostupný">
   <svg class="wind-dial-v2" viewBox="0 0 200 200" focusable="false" aria-hidden="true">
    <circle class="wind-dial-ring" cx="100" cy="100" r="72"/>
    <circle class="wind-dial-ring-inner" cx="100" cy="100" r="62"/>
    <g class="wind-tick-major">
     <path d="M100 28 V37 M100 163 V172 M28 100 H37 M163 100 H172"/>
     <path d="M100 28 V37 M100 163 V172 M28 100 H37 M163 100 H172" transform="rotate(45 100 100)"/>
    </g>
    <g class="wind-cardinal-text">
     <text x="100" y="17">S</text><text x="184" y="105">V</text>
     <text x="100" y="193">J</text><text x="16" y="105">Z</text>
    </g>
    <g class="wind-bearing-v2" data-wind-bearing>
     <path class="wind-pointer-head" d="M100 26 L110 47 L100 43 L90 47 Z"/>
     <path class="wind-pointer-stem" d="M100 44 V55"/>
    </g>
   </svg>
   <div class="wind-core-v2" aria-hidden="true">
    <p class="wind-degrees"><strong data-wind-degrees>—</strong><span>°</span></p>
    <p class="wind-sector-short-v2" data-wind-sector-short>—</p>
   </div>
  </div>
  <div class="observatory-wind-readout wind-readout-v2">
   <p class="observatory-wind-direction" data-wind-sector>Směr se načítá</p>
   <p class="source-note" data-wind-description>Čeká na ověřený archivní směr větru.</p>
   <div class="wind-speed-pair wind-metrics-v2" aria-label="Rychlost a nárazy větru">
    <div class="wind-metric-v2"><span>Rychlost</span><strong><span data-wind-value="windSpeed">—</span> <small>m/s</small></strong><small data-wind-source="windSpeed">Načítám</small></div>
    <div class="wind-metric-v2"><span>Nárazy</span><strong><span data-wind-value="windGust">—</span> <small>m/s</small></strong><small data-wind-source="windGust">Načítám</small></div>
   </div>
  </div>
 </div>
 <p class="observatory-source-note">Ukazatel na kružnici označuje, odkud vítr vane. U každé hodnoty uvádíme její zdroj.</p>
</section>
<script>
 import {getCurrent} from '../../shared/api/client';
 import {describeWindFrom,nearestWindRotation} from '../../shared/domain/wind-direction';

 const root=document.querySelector<HTMLElement>('[data-wind-compass]');
 if(root){
  const controller=new AbortController();
  const status=root.querySelector<HTMLElement>('[data-wind-status]');
  const number=root.querySelector<HTMLElement>('[data-wind-degrees]');
  const pointer=root.querySelector<SVGGElement>('[data-wind-bearing]');
  const sector=root.querySelector<HTMLElement>('[data-wind-sector]');
  const sectorShort=root.querySelector<HTMLElement>('[data-wind-sector-short]');
  const description=root.querySelector<HTMLElement>('[data-wind-description]');
  const gauge=root.querySelector<HTMLElement>('[data-wind-valid]');
  let lastRotation:number|null=null;

  const setWind=(id:'windSpeed'|'windGust',value:number|null,source:string)=>{
   const reading=root.querySelector<HTMLElement>('[data-wind-value="'+id+'"]');
   const note=root.querySelector<HTMLElement>('[data-wind-source="'+id+'"]');
   if(reading)reading.textContent=value===null?'—':new Intl.NumberFormat('cs-CZ',{
    minimumFractionDigits:1,maximumFractionDigits:1
   }).format(value);
   if(note)note.textContent=source;
  };

  const clearDirection=(reason:string)=>{
   if(number)number.textContent='—';
   if(sectorShort)sectorShort.textContent='—';
   if(sector)sector.textContent='Směr není k dispozici';
   if(description)description.textContent=reason;
   if(gauge){
    gauge.dataset.windValid='false';
    gauge.setAttribute('aria-label','Směr větru není dostupný');
   }
   lastRotation=null;
  };

  const show=(value:number,source:string,stale=false)=>{
   const wind=describeWindFrom(value);
   if(!wind)return;
   if(number)number.textContent=new Intl.NumberFormat('cs-CZ').format(wind.rounded);
   if(sectorShort)sectorShort.textContent=wind.short;
   if(sector)sector.textContent=wind.long+' vítr';
   if(pointer){
    lastRotation=nearestWindRotation(lastRotation,wind.degrees);
    pointer.style.transform='rotate('+lastRotation+'deg)';
   }
   if(gauge){
    gauge.dataset.windValid='true';
    gauge.setAttribute('aria-label','Vítr přichází z '+wind.rounded+' stupňů, '+wind.long);
   }
   if(status){status.textContent=source;status.className='status-chip '+(stale?'warning':'ok');}
   if(description)description.textContent=stale?'Starší archivní směr větru':'Směr odkud vítr vane · '+source;
  };

  const load=()=>{
   void getCurrent(controller.signal).then(response=>{
    if(controller.signal.aborted)return;
    for(const id of ['windSpeed','windGust'] as const){
     const item=response.readings[id];
     const valid=Boolean(item&&item.value!==null&&Number.isFinite(item.value)&&
      item.quality!=='missing'&&item.quality!=='suspect');
     setWind(id,valid&&item&&typeof item.value==='number'?item.value:null,
      valid?(response.stale?'Starší archiv WeeWX':'Archiv WeeWX'):'Nedostupné');
    }
    const reading=response.readings.windDir;
    if(!reading||reading.value===null||reading.quality==='missing'||
     reading.quality==='suspect'||!Number.isFinite(reading.value)){
     clearDirection('Ověřený směr větru není k dispozici.');
     if(status){status.textContent='Bez platného směru';status.className='status-chip warning';}
     return;
    }
    show(reading.value,'Archiv WeeWX',response.stale);
   }).catch(()=>{
    if(controller.signal.aborted)return;
    clearDirection('Směr větru se nepodařilo načíst.');
    if(status){status.textContent='API nedostupné';status.className='status-chip error';}
    setWind('windSpeed',null,'API nedostupné');
    setWind('windGust',null,'API nedostupné');
   });
  };

  const live=(event:Event)=>{
   if(controller.signal.aborted)return;
   const data=(event as CustomEvent<{state:string;receivedAt:string;units:string;
    readings:Record<string,{value:number;quality:string;source:string}>}>).detail;
   if(data?.state!=='live'||data.units!=='metricwx'||
    !Number.isFinite(Date.parse(data.receivedAt))||
    Date.now()-Date.parse(data.receivedAt)>120000)return;
   for(const id of ['windSpeed','windGust'] as const){
    const value=data.readings?.[id];
    if(value?.source==='gw3000_live'&&value.quality==='measured'&&
     typeof value.value==='number'&&Number.isFinite(value.value))
     setWind(id,value.value,'Živě · GW3000');
   }
   const reading=data.readings?.windDir;
   if(reading?.source==='gw3000_live'&&reading.quality==='measured'&&
    typeof reading.value==='number'&&Number.isFinite(reading.value))
    show(reading.value,'Živě · GW3000');
  };

  const restore=()=>load();
  window.addEventListener('loucka:live-observation',live);
  window.addEventListener('loucka:live-expired',restore);
  load();
  document.addEventListener('astro:before-swap',()=>{
   controller.abort();
   window.removeEventListener('loucka:live-observation',live);
   window.removeEventListener('loucka:live-expired',restore);
  },{once:true});
 }
</script>
