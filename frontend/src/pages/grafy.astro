---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvancedHistory from '../features/history/AdvancedHistory.astro';
import HistoryPanel from '../features/history/HistoryPanel.astro';
import RainDetail from '../features/history/RainDetail.astro';
---
<BaseLayout title="Grafy a historie">
 <div class="page-intro">
  <span class="eyebrow">Meteorologický archiv od roku 2009</span>
  <h1>Historická data</h1>
  <p>Porovnání veličin, interaktivní rozsahy, výběr data a stažení skutečně naměřených dat.</p>
 </div>
 <p class="source-note">Chceš zobrazit teplotu všech roků najednou? <a href="/klimatologie/#teplota-vsechny-roky">Otevři společný graf teplot 2009–dnes</a>. Hledáš kalendářní heatmapy nebo porovnání dvou roků? <a href="/klimatologie/#srovnani-let">Otevři meziroční porovnání v Klimatologii</a>.</p>
 <AdvancedHistory />
 <RainDetail />
 <HistoryPanel />
</BaseLayout>
