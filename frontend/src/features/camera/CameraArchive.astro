<section class="section camera-archive-section" data-camera-archive aria-labelledby="camera-archive-title">
 <div class="section-heading"><div><span class="eyebrow">Skutečně uložené záznamy</span><h2 id="camera-archive-title">Archiv západní kamery a časosběr</h2></div><span class="status-chip" data-archive-status role="status">Zjišťuji archiv</span></div>
 <p class="lead">Historie vzniká z veřejného snímku při archivaci na LXC. Čas pod fotografií znamená čas stažení, nikoli ověřený čas pořízení kamerou. Historii před zapnutím archivace nelze získat z jediného aktuálního JPEG.</p>
 <div class="camera-archive-grid" data-archive-frames></div>
 <div class="camera-day-browser">
  <div class="section-heading">
   <h3>Procházet archiv podle dne</h3>
   <label class="camera-day-choice">Den (UTC) <input type="date" data-archive-date /></label><button type="button" class="chart-tab" data-archive-load-day>Načíst den</button>
  </div>
  <p class="source-note" data-archive-day-status>Vyber datum od začátku archivace.</p>
  <div class="camera-archive-grid" data-archive-day-frames></div>
  <div class="camera-day-pagination" data-archive-page-controls hidden>
   <button type="button" class="chart-tab" data-archive-previous>← Předchozí</button>
   <span class="source-note" data-archive-page-label>1 / 1</span>
   <button type="button" class="chart-tab" data-archive-next>Další →</button>
  </div>
 </div>
 <div class="camera-timelapse-block">
  <div class="section-heading"><h3>Denní časosběrné video</h3><select data-archive-video aria-label="Vybrat den časosběru" disabled><option>Žádné video</option></select></div>
  <video controls preload="none" playsinline data-archive-player hidden aria-label="Časosběr z kamerových archivních fotografií"></video>
  <p class="source-note" data-archive-video-note>Video se vytvoří z alespoň šesti uložených snímků předchozího dne, pokud je na LXC dostupný FFmpeg.</p>
 </div>
</section>
<script>
 const root=document.querySelector<HTMLElement>('[data-camera-archive]');
 if(root){
  const status=root.querySelector<HTMLElement>('[data-archive-status]');
  const frames=root.querySelector<HTMLElement>('[data-archive-frames]');
  const select=root.querySelector<HTMLSelectElement>('[data-archive-video]');
  const player=root.querySelector<HTMLVideoElement>('[data-archive-player]');
  const ctrl=new AbortController();
  // The public reverse proxy limits concurrent requests. Scheduling thumbnails
  // prevents dozens of JPEG requests from triggering HTTP 429 and blank cards.
  const thumbnailQueue:Array<()=>void>=[];
  const scheduler=setInterval(()=>{
   if(ctrl.signal.aborted){thumbnailQueue.length=0;return;}
   thumbnailQueue.shift()?.();
  },450);
  function makeThumb(url:string,description:string):HTMLImageElement{
   const img=document.createElement('img');
   img.alt=description;img.loading='eager';img.decoding='async';
   // Never expose the browser's broken-image icon while a frame is pending or
   // when the camera server responds with 429/502. Preserve the clickable link.
   img.hidden=true;
   const loading=document.createElement('span');
   loading.className='camera-thumb-message';
   loading.textContent='Náhled se načítá…';
   img.addEventListener('load',()=>{img.hidden=false;loading.remove();},{once:true});
   let failed=0;
   img.addEventListener('error',()=>{
    img.hidden=true;
    failed++;
    if(failed===1&&!ctrl.signal.aborted){
     loading.textContent='Opakuji načtení…';
     setTimeout(()=>{
      if(!ctrl.signal.aborted&&img.isConnected){
       thumbnailQueue.push(()=>{if(img.isConnected)img.src=url+'?retry=1';});
      }
     },3000);
    }else loading.textContent='Náhled není dostupný · otevřít originál';
   });
   thumbnailQueue.push(()=>{if(img.isConnected)img.src=url;});
   // The image and loading message are siblings. The caller appends img to a link.
   queueMicrotask(()=>{if(img.isConnected)img.insertAdjacentElement('afterend',loading);});
   return img;
  }
  type Frame={fetchedAt:string;url:string};
  type Video={date:string;url:string};
  void fetch('/api/v1/camera/archive',{signal:ctrl.signal}).then(r=>r.json() as Promise<{status:string;frames:Frame[];videos:Video[]}>).then(data=>{
   if(ctrl.signal.aborted||!frames)return;
   frames.replaceChildren();
   if(data.status!=='ok'||!data.frames.length){
    const empty=document.createElement('div');empty.className='empty-state';
    empty.textContent='Archiv zatím nemá žádné zachycené snímky. Je potřeba jednorázově zapnout sběrnou systemd službu.';
    frames.append(empty);if(status)status.textContent='Archiv zatím prázdný';
   }else{
    if(status){status.textContent=data.frames.length+' dostupných snímků';status.className='status-chip ok';}
    const formatter=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    for(const f of data.frames.slice(0,8)){
     if(!/^\/api\/v1\/camera\/frames\/\d{8}T\d{6}Z\.jpg$/.test(f.url))continue;
     const link=document.createElement('a');link.className='camera-archive-thumb';link.href=f.url;link.target='_blank';link.rel='noopener noreferrer';
     const img=makeThumb(f.url,'Archivní snímek ze západní kamery');
     const label=document.createElement('span');label.textContent='Staženo '+formatter.format(new Date(f.fetchedAt));
     link.append(img,label);frames.append(link);
    }
   }
   if(select&&player&&data.videos?.length){
    select.replaceChildren();
    const videos=data.videos.filter(v=>/^\/api\/v1\/camera\/timelapse\/\d{4}-\d{2}-\d{2}\.mp4$/.test(v.url));
    for(const v of videos){const option=document.createElement('option');option.value=v.url;option.textContent=v.date;select.append(option);}
    if(videos.length){
     const note=root.querySelector<HTMLElement>('[data-archive-video-note]');
     if(note)note.textContent='Uložené MP4 je dostupné; časosběr se sestavuje z archivovaných fotografií.';
     select.disabled=false;player.hidden=false;player.src=videos[0].url;
     select.addEventListener('change',()=>{player.src=select.value;player.load();});
    }
   } else {
    const note=root.querySelector<HTMLElement>('[data-archive-video-note]');
    if(note)note.textContent='Zatím není dostupné žádné časosběrné MP4. Převod probíhá až po uzavření dne, pokud existuje alespoň šest snímků a funguje FFmpeg.';
   }
  }).catch(()=>{
   if(ctrl.signal.aborted)return;
   if(status)status.textContent='Archiv nedostupný';
   if(frames)frames.textContent='Historii fotografií se nepodařilo načíst.';
  });
  const dateInput=root.querySelector<HTMLInputElement>('[data-archive-date]');
  const dayContainer=root.querySelector<HTMLElement>('[data-archive-day-frames]');
  const dayStatus=root.querySelector<HTMLElement>('[data-archive-day-status]');
  const pagination=root.querySelector<HTMLElement>('[data-archive-page-controls]');
  const prev=root.querySelector<HTMLButtonElement>('[data-archive-previous]');
  const next=root.querySelector<HTMLButtonElement>('[data-archive-next]');
  const label=root.querySelector<HTMLElement>('[data-archive-page-label]');
  const dateNow=new Date();
  const dateStr=(d:Date)=>d.toISOString().slice(0,10);
  if(dateInput){
   dateInput.max=dateStr(dateNow);
   dateInput.min=dateStr(new Date(dateNow.getTime()-35*86400000));
   dateInput.value=dateInput.max;
  }
  let dayFrames:Frame[]=[],activePage=0;
  const perPage=20;
  const dateFormatter=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',
   day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
  function renderDay(){
   if(!dayContainer)return;
   dayContainer.replaceChildren();
   const total=Math.ceil(dayFrames.length/perPage);
   const current=dayFrames.slice(activePage*perPage,(activePage+1)*perPage);
   for(const frame of current){
    if(!/^\/api\/v1\/camera\/frames\/\d{8}T\d{6}Z\.jpg$/.test(frame.url))continue;
    const a=document.createElement('a');a.href=frame.url;a.className='camera-archive-thumb';
    a.rel='noopener noreferrer';a.target='_blank';
    const img=makeThumb(frame.url,'Archivní snímek západní kamery');
    const date=document.createElement('span');date.textContent='Staženo '+dateFormatter.format(new Date(frame.fetchedAt));
    a.append(img,date);dayContainer.append(a);
   }
   if(pagination)pagination.hidden=total<2;
   if(label)label.textContent=(activePage+1)+' / '+Math.max(1,total);
   if(prev)prev.disabled=activePage===0;
   if(next)next.disabled=activePage>=total-1;
  }
  async function loadDay(){
   if(!dateInput||!dayContainer||ctrl.signal.aborted)return;
   const date=dateInput.value;
   if(!/^20\d{2}-\d{2}-\d{2}$/.test(date))return;
   if(dayStatus)dayStatus.textContent='Načítám uložené snímky…';
   try{
    const response=await fetch('/api/v1/camera/archive/day/'+date,{signal:ctrl.signal});
    if(!response.ok)throw Error('Archive day '+response.status);
    const data=await response.json() as {status:string;frames:Frame[]};
    if(ctrl.signal.aborted)return;
    dayFrames=Array.isArray(data.frames)?data.frames:[];activePage=0;renderDay();
    if(dayStatus)dayStatus.textContent=data.status==='ok'?
     dayFrames.length+' skutečně uložených snímků za '+date+' (UTC)':
     'Tento den není v dostupném archivu.';
   }catch{
    if(ctrl.signal.aborted)return;
    dayFrames=[];activePage=0;renderDay();
    if(dayStatus)dayStatus.textContent='Archiv se nepodařilo načíst.';
   }
  }
  dateInput?.addEventListener('change',()=>void loadDay());
  root.querySelector<HTMLButtonElement>('[data-archive-load-day]')?.addEventListener('click',()=>void loadDay());
  prev?.addEventListener('click',()=>{if(activePage>0){activePage--;renderDay();}});
  next?.addEventListener('click',()=>{if((activePage+1)*perPage<dayFrames.length){activePage++;renderDay();}});
  // Date selection is opt-in; avoid doubling immediate JPEG traffic on page load.
  if(dayStatus)dayStatus.textContent='Zvol datum a klikni na Načíst den.';
  document.addEventListener('astro:before-swap',()=>{ctrl.abort();clearInterval(scheduler);thumbnailQueue.length=0;player?.pause();},{once:true});
 }
</script>