{
  "name": "loucka-weather-api",
  "private": true,
  "version": "0.1.0-staging",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "qc:report": "node scripts/qc-report.mjs",
    "qc:batch": "node scripts/qc-batch.mjs",
    "test": "npm run build && node --check scripts/read-only-query-plan.mjs && node --test dist/test/*.test.js test/qc-*.test.mjs",
    "qc:quality": "node scripts/qc-quality-overview.mjs",
    "qc:recover": "node scripts/qc-recover-candidates.mjs",
    "qc:rh-2022": "node scripts/qc-humidity-2022.mjs",
    "qc:rh-triage": "node scripts/qc-rh-triage.mjs",
    "qc:rh-triplets": "node scripts/qc-rh-triplets.mjs",
    "qc:rh-holdout": "node scripts/qc-rh-holdout.mjs",
    "qc:rh-readiness": "node scripts/qc-rh-readiness.mjs",
    "qc:rh-backup-inventory": "node scripts/qc-rh-backup-inventory.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "mariadb": "3.5.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^24.10.1"
  }
}
