<div data-model-map class="model-map-controls">
 <label class="map-layer-option"><input type="checkbox" data-model-temperature /> Teplota · barevná vrstva <small>Open-Meteo</small></label>
 <label class="map-layer-option"><input type="checkbox" data-model-wind /> Vítr · směrové šipky <small>Open-Meteo</small></label>
 <div class="model-temperature-key" data-temperature-key hidden><div></div><span>−30 °C</span><span>0 °C</span><span>40 °C</span></div>
 <p class="source-note" data-model-status role="status">Modelové vrstvy jsou vypnuté.</p>
 <button type="button" class="chart-tab model-refresh" data-model-refresh hidden>Načíst model pro tento výřez</button>
 <div class="model-point-detail" data-model-detail hidden role="status"></div>
 <details class="model-point-list" data-model-list hidden><summary>Vzorkované hodnoty modelu</summary><div data-model-values></div></details>
 <p class="source-note">Teplota je interpolace vzorků z modelu, nikoli měření či nativní rastr. Šipky ukazují směr, kam vítr fouká. Zdroj: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a> (CC BY 4.0).</p>
 <div class="model-station-card"><strong>Meteostanice Loučka</strong><p data-map-station-value>Načítám poslední měření…</p><a href="/aktualne/">Podrobná měření ↗</a></div>
 <p class="source-note"><a href="https://opendata.chmi.cz/meteorology/climate/now/" target="_blank" rel="noopener noreferrer">Skutečná měření ČHMÚ – otevřená data ↗</a></p>
</div>
<script>
 import {sampleGrid,interpolate,temperatureColor,screenPosition,station,type View} from './map-geometry';
 import {getCurrent} from '../../shared/api/client';
 import {formatTimestamp} from '../../shared/domain/weather';
 const root=document.querySelector<HTMLElement>('[data-model-map]');
 const map=document.querySelector<HTMLElement>('.map-page-primary [data-radar-map]');
 const temp=root?.querySelector<HTMLInputElement>('[data-model-temperature]'),wind=root?.querySelector<HTMLInputElement>('[data-model-wind]');
 const state=root?.querySelector<HTMLElement>('[data-model-status]'),detail=root?.querySelector<HTMLElement>('[data-model-detail]'),list=root?.querySelector<HTMLDetailsElement>('[data-model-list]');
 const valuesRoot=root?.querySelector<HTMLElement>('[data-model-values]'),refresh=root?.querySelector<HTMLButtonElement>('[data-model-refresh]'),key=root?.querySelector<HTMLElement>('[data-temperature-key]');
 const controller=new AbortController();
 let pending:AbortController|undefined,inflightKey='',loadedKey='',lastRequest=0,timer:number|undefined;
 type Sample={current?:{temperature_2m?:number;wind_speed_10m?:number;wind_direction_10m?:number;time?:string};current_units?:Record<string,string>};
 let model:Sample[]|undefined,grid:ReturnType<typeof sampleGrid>|undefined,view:View|undefined;
 const overlay=document.createElement('div');overlay.className='model-overlay';overlay.hidden=true;map?.append(overlay);
 const stationLabel=document.createElement('a');stationLabel.className='map-station-label';stationLabel.href='/aktualne/';stationLabel.textContent='Loučka · stanice';stationLabel.hidden=true;map?.append(stationLabel);
 const stationValue=root?.querySelector<HTMLElement>('[data-map-station-value]');
 let stationText='Loučka · stanice';
 const fmt=(v:number,digits=0)=>new Intl.NumberFormat('cs-CZ',{maximumFractionDigits:digits}).format(Math.abs(v)<0.5*10**-digits?0:v);
 const enabled=()=>!!(temp?.checked||wind?.checked);
 const readView=()=>{try{return JSON.parse(map?.dataset.mapView??'null') as View|null;}catch{return null;}};
 const viewKey=(v:View)=>JSON.stringify([v.center.lat,v.center.lon,v.zoom,v.scale,v.width,v.height]);
 const valid=(n:unknown):n is number=>typeof n==='number'&&Number.isFinite(n);
 const unit=(s:Sample,k:string,u:string)=>s.current_units?.[k]===u;
 const temperature=(s:Sample)=>unit(s,'temperature_2m','°C')&&valid(s.current?.temperature_2m)?s.current!.temperature_2m!:null;
 const windValue=(s:Sample)=>unit(s,'wind_speed_10m','km/h')&&valid(s.current?.wind_speed_10m)&&s.current!.wind_speed_10m!>=0?s.current!.wind_speed_10m!:null;
 const direction=(s:Sample)=>unit(s,'wind_direction_10m','°')&&valid(s.current?.wind_direction_10m)&&s.current!.wind_direction_10m!>=0&&s.current!.wind_direction_10m!<=360?s.current!.wind_direction_10m!:null;
 const stationPosition=()=>{
  const v=readView();if(!v)return;const p=screenPosition(station,v);
  stationLabel.hidden=p.x<42||p.x>v.width-42||p.y<15||p.y>v.height-20;
  stationLabel.style.left=p.x+'px';stationLabel.style.top=p.y+'px';stationLabel.textContent=stationText;
 };
 void getCurrent(controller.signal).then(r=>{
  const t=r.readings.outTemp,w=r.readings.windSpeed;
  const measured=(reading:typeof t)=>reading?.quality==='measured'&&valid(reading.value);
  const parts=[measured(t)?fmt(t!.value!,1)+' '+t!.unit:null,measured(w)?fmt(w!.value!,1)+' '+w!.unit:null].filter(Boolean);
  if(stationValue)stationValue.textContent=parts.length?parts.join(' · ')+' · '+(r.stale?'Zastaralé měření':'Poslední archivní měření')+' '+formatTimestamp(r.observedAt):'Měření není dostupné.';
  if(measured(t)&&!r.stale)stationText='Loučka · '+fmt(t!.value!,1)+' '+t!.unit;
  stationPosition();
 }).catch(()=>{if(stationValue&&!controller.signal.aborted)stationValue.textContent='Měření není dostupné.';});
 function clear(){
  overlay.replaceChildren();overlay.hidden=true;if(detail)detail.hidden=true;if(list)list.hidden=true;if(valuesRoot)valuesRoot.replaceChildren();if(key)key.hidden=true;
 }
 function draw(){
  clear();if(!enabled()||!model||!grid||!view||loadedKey!==viewKey(readView()??view))return;
  overlay.hidden=false;const {cols,rows,points}=grid;
  if(temp?.checked&&model.some(s=>temperature(s)!==null)){
   const canvas=document.createElement('canvas');canvas.className='model-temperature-canvas';canvas.width=160;canvas.height=Math.max(60,Math.min(160,Math.round(160*view.height/view.width)));canvas.setAttribute('aria-hidden','true');
   const ctx=canvas.getContext('2d');
   if(ctx){const img=ctx.createImageData(canvas.width,canvas.height),samples=model.map(temperature);
    for(let y=0;y<canvas.height;y++)for(let x=0;x<canvas.width;x++){const v=interpolate(samples,cols,rows,x/(canvas.width-1),y/(canvas.height-1));if(v===null)continue;const c=temperatureColor(v),i=(y*canvas.width+x)*4;img.data[i]=c[0]!;img.data[i+1]=c[1]!;img.data[i+2]=c[2]!;img.data[i+3]=118;}
    ctx.putImageData(img,0,0);overlay.append(canvas);if(key)key.hidden=false;
   }
  }
  model.forEach((s,i)=>{
   const p=points[i]!,t=temperature(s),w=windValue(s),d=direction(s);
   const parts=[temp?.checked&&t!==null?fmt(t,1)+' °C':null,wind?.checked&&w!==null?fmt(w,1)+' km/h':null,wind?.checked&&d!==null?'směr od '+fmt(d)+'°':null].filter(Boolean);
   if(!parts.length)return;
   const desc=p.lat.toFixed(3)+'° N, '+p.lon.toFixed(3)+'° E · '+parts.join(' · ');
   const row=document.createElement('div');row.className='model-point-row';row.textContent=desc;valuesRoot?.append(row);
   if(!wind?.checked||w===null||d===null)return;
   const xy=screenPosition(p,view!),stationXY=screenPosition(station,view!);
   // Sample boundary vertices are rendered just inside the map; the list retains exact coordinates.
   xy.x=Math.max(18,Math.min(view!.width-18,xy.x));xy.y=Math.max(18,Math.min(view!.height-58,xy.y));
   if((xy.x<150&&xy.y<184)||Math.hypot(xy.x-stationXY.x,xy.y-stationXY.y)<48)return;
   const b=document.createElement('button');b.type='button';b.className='model-wind-arrow';b.dataset.modelPoint=String(i);b.style.left=xy.x+'px';b.style.top=xy.y+'px';b.title=desc;b.setAttribute('aria-label',desc);
   const arrow=document.createElement('span');arrow.textContent=w<0.5?'•':'↑';arrow.style.transform='rotate('+(d+180)+'deg)';b.append(arrow);
   b.addEventListener('click',()=>{if(detail){detail.hidden=false;detail.textContent=desc;}});overlay.append(b);
  });
  if(list)list.hidden=false;
  if(state)state.textContent=grid.points.length+' vzorků modelu'+(temp?.checked?' · interpolace teploty':'')+(model[0]?.current?.time?' · '+model[0].current.time.replace('T',' '):'')+(temp?.checked&&!model.some(s=>temperature(s)!==null)?' · teplota nedostupná':'')+(wind?.checked&&!model.some(s=>windValue(s)!==null&&direction(s)!==null)?' · vítr nedostupný':'');
  if(refresh)refresh.hidden=true;
 }
 async function load(){
  const v=readView();if(!v||!enabled())return;
  const id=viewKey(v);if(model&&loadedKey===id){draw();return;}
  if(pending&&!pending.signal.aborted&&inflightKey===id)return;
  if(Date.now()-lastRequest<2500){window.clearTimeout(timer);timer=window.setTimeout(()=>void load(),2500-(Date.now()-lastRequest));return;}
  pending?.abort();pending=new AbortController();const signal=pending.signal;inflightKey=id;lastRequest=Date.now();
  clear();if(state)state.textContent='Načítám model pro zobrazenou oblast…';
  const g=sampleGrid(v);
  const params=new URLSearchParams({latitude:g.points.map(p=>p.lat.toFixed(4)).join(','),longitude:g.points.map(p=>p.lon.toFixed(4)).join(','),current:'temperature_2m,wind_speed_10m,wind_direction_10m',wind_speed_unit:'kmh',timezone:'Europe/Prague'});
  try{
   const res=await fetch('https://api.open-meteo.com/v1/forecast?'+params,{signal});if(!res.ok)throw Error('model');
   const data=await res.json() as unknown;
   if(signal.aborted||!enabled()||viewKey(readView()??v)!==id)return;
   if(!Array.isArray(data)||data.length!==g.points.length||!data.every(s=>s&&typeof s==='object'))throw Error('samples');
   const samples=data as Sample[];if(!samples.some(s=>temperature(s)!==null||windValue(s)!==null))throw Error('units');
   model=samples;grid=g;view=v;loadedKey=id;draw();
  }catch{if(!signal.aborted){if(state)state.textContent='Modelová data nedostupná. Radar a měření fungují nezávisle.';if(refresh)refresh.hidden=false;}}
  finally{if(pending?.signal===signal){pending=undefined;inflightKey='';}}
 }
 function toggle(){
  if(!enabled()){pending?.abort();window.clearTimeout(timer);clear();if(state)state.textContent='Modelové vrstvy jsou vypnuté.';if(refresh)refresh.hidden=true;return;}
  const v=readView();if(v&&loadedKey===viewKey(v)&&model)draw();else void load();
 }
 function changed(){
  stationPosition();if(!enabled())return;
  const v=readView();if(v&&loadedKey===viewKey(v)){draw();return;}
  pending?.abort();window.clearTimeout(timer);clear();if(state)state.textContent='Výřez mapy se změnil. Načti model pro novou oblast.';if(refresh)refresh.hidden=false;
 }
 temp?.addEventListener('change',toggle,{signal:controller.signal});wind?.addEventListener('change',toggle,{signal:controller.signal});refresh?.addEventListener('click',()=>void load(),{signal:controller.signal});map?.addEventListener('loucka:map-view',changed,{signal:controller.signal});
 stationPosition();
 document.addEventListener('astro:before-swap',()=>{controller.abort();pending?.abort();window.clearTimeout(timer);overlay.remove();stationLabel.remove();},{once:true});
</script>
<style is:global>
.radar-map>.model-overlay{position:absolute;inset:0;pointer-events:none;z-index:2}
.radar-map>.model-overlay[hidden]{display:none}
.model-temperature-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.model-wind-arrow{position:absolute;width:30px;height:30px;transform:translate(-50%,-50%);display:grid;place-items:center;padding:0;border:1px solid #fff;border-radius:50%;background:#123744e8;color:#fff;font:700 20px/1 system-ui;pointer-events:auto;cursor:pointer}
.model-wind-arrow span{display:block}
.map-station-label{position:absolute;transform:translate(-50%,-50%);z-index:3;background:#fff;color:#123744;border:2px solid #db323e;padding:5px 8px;font-size:12px;font-weight:700;border-radius:5px;white-space:nowrap;text-decoration:none;box-shadow:0 1px 4px #0006}
.map-station-label[hidden]{display:none}
.map-page-primary .radar-pin{display:none}
.model-temperature-key{display:grid;grid-template-columns:1fr 1fr 1fr;font-size:11px;gap:4px;margin:10px 0}
.model-temperature-key[hidden]{display:none}
.model-temperature-key div{grid-column:1/-1;height:12px;border-radius:4px;background:linear-gradient(90deg,#411e91 0%,#354fb8 21.43%,#41b1da 42.86%,#4cb76a 57.14%,#f7da4f 71.43%,#f0762c 85.71%,#b52730 100%)}
 .model-temperature-key{position:relative}.model-temperature-key span:nth-of-type(2){position:absolute;top:16px;left:42.86%;transform:translateX(-50%);white-space:nowrap} .model-temperature-key span:last-child{grid-column:3;text-align:right}
.model-point-detail,.model-station-card{background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:10px;margin:8px 0;font-size:13px}
.model-point-detail[hidden],.model-refresh[hidden],.model-point-list[hidden]{display:none}
.model-station-card p{margin:6px 0;line-height:1.4}
.model-point-list summary{cursor:pointer;min-height:44px;align-content:center;font-weight:650;font-size:13px}
.model-point-row{font-size:12px;padding:7px 0;border-top:1px solid var(--line)}
.model-map-controls .source-note{font-size:12px;line-height:1.45}
.model-refresh{min-height:44px;white-space:normal}
</style>
