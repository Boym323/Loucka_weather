{
  "policyVersion": "draft-2026-10-31-v2",
  "status": "proposed, domain review required",
  "source": "WeeWX 5.x daily summaries and archive semantics",
  "defaultAggregationProhibited": true,
  "measuredMetrics": 45,
  "semantics": {
    "count": "count of non-null valid observations; NOT lightning strike tally",
    "mean": "time weighted by verified interval seconds; daily summary wsum/sumtime where available; never average daily averages unweighted",
    "sum": "additive interval quantities ONLY; null excluded and coverage disclosed",
    "max": "archive maxima for sample series; daily summary may include LOOP extremes if explicitly requested, source flagged",
    "min": "archive minima for sample series; daily summary may include LOOP extremes if explicitly requested, source flagged",
    "vecdir": "vector direction from paired wind speed and direction; null on calm/undefined resultant",
    "dir_at_max": "direction recorded at the same event as maximum wind gust"
  },
  "weeklyOrMore": "roll up verified daily summaries, not naive averages; reject unsupported metric aggregation pairs with 422 INVALID_AGGREGATION",
