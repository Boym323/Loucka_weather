---
import MetricCard from '../../shared/ui/MetricCard.astro';
import { metrics } from '../../shared/domain/metrics';
interface Props { variant?: 'dashboard' | 'detail' }
const { variant = 'detail' } = Astro.props;
// Homepage: 6 compact cards plus a separate row of contextual readings.
// Detail page keeps the full public selection.
const view = variant === 'dashboard' ? metrics.slice(0, 6) : metrics;
const quickReadings = [
 { id:'radiation', label:'Sluneční záření', unit:'W/m²', digits:0 },
 { id:'UV', label:'UV index', unit:'', digits:1 },
 { id:'pm25_1', label:'PM2,5', unit:'µg/m³', digits:1 },
 { id:'rain', label:'Srážky v intervalu', unit:'mm', digits:1 }
];
---
<section class="section current-panel" data-current-panel data-variant={variant} aria-labelledby="current-title">
 <div class="section-heading">
  <div><span class="eyebrow">Aktuální počasí · GW3000 / WeeWX</span><h2 id="current-title">{variant==='dashboard'?'Aktuální podmínky':'Aktuální údaje'}</h2></div>
  <span data-current-status class="status-chip" role="status">Načítám měření</span>
 </div>
 <p class="source-note" data-current-updated>Čekám na poslední archivní záznam.</p>
 <div class="metric-grid">
  {view.map((metric,index)=><MetricCard id={metric.id} label={metric.label} unit={metric.unit} featured={index===0} />)}
 </div>
 {variant==='dashboard' && <div class="quick-reading-grid" aria-label="Doplňková měření">
  {quickReadings.map(metric => <div class="quick-reading">
   <span class="quick-label">{metric.label}</span>
   <strong><span data-quick-value={metric.id}>—</span><small>{metric.unit}</small></strong>
   <span class="sr-only" data-quick-quality={metric.id}>Čeká na měření</span>
  </div>)}
 </div>}
 <p class="source-note source-note-bottom" data-current-provenance>Původní archiv WeeWX · METRICWX · podezřelé a chybějící údaje se nezobrazují jako nula.</p>
</section>
<script>
 import { getCurrent } from '../../shared/api/client';
 import { formatValue, metrics } from '../../shared/domain/metrics';
 import { formatTimestamp } from '../../shared/domain/weather';
 const section=document.querySelector<HTMLElement>('[data-current-panel]')!;
 const status=section?.querySelector<HTMLElement>('[data-current-status]');
 const updated=section?.querySelector<HTMLElement>('[data-current-updated]');
 const provenance=section?.querySelector<HTMLElement>('[data-current-provenance]');
 const controller=new AbortController();
 let lastLiveEvent:Event|undefined;
 let archiveRetryCount=0;
 let archiveRetryTimer:ReturnType<typeof setTimeout>|undefined;
 // Archive GET can transiently hit the public reverse-proxy rate limit during
 // live->archive failover. Retry a bounded number of times without page reload.
 const refresh=()=>getCurrent(controller.signal).then(response=>{
  archiveRetryCount=0;
  if(archiveRetryTimer){clearTimeout(archiveRetryTimer);archiveRetryTimer=undefined;}
  if(status){
   status.textContent=response.stale?'Zastaralé měření':'Archivní měření';
   status.classList.add(response.stale?'warning':'ok');
  }
  if(updated)updated.textContent='Naměřeno '+formatTimestamp(response.observedAt)+' · původní archiv';
  if(provenance)provenance.textContent='Původní archiv WeeWX · METRICWX · podezřelé a chybějící údaje se nezobrazují jako nula.';
  for(const metric of metrics){
   const node=section.querySelector<HTMLElement>('[data-metric-value="'+metric.id+'"]');
   const quality=section.querySelector<HTMLElement>('[data-metric-quality="'+metric.id+'"]');
   const reading=response.readings[metric.id];
   if(!reading||reading.value===null||reading.quality==='missing'||reading.quality==='suspect'){
    if(node)node.textContent='—';
    if(quality){quality.textContent=reading?.quality==='suspect'?'Podezřelý údaj':'Nedostupné měření';quality.dataset.readingState=reading?.quality==='suspect'?'suspect':'missing';}
    continue;
   }
   if(node)node.textContent=formatValue(reading.value,metric.digits);
   if(quality){
    quality.textContent=reading.quality==='reconstructed'?'Rekonstruované měření':
    reading.quality==='derived'?'Odvozené měření':'Archivní měření';
    quality.dataset.readingState=reading.quality;
   }
  }
  const quick=[{id:'radiation',digits:0},{id:'UV',digits:1},{id:'pm25_1',digits:1},{id:'rain',digits:1}];
  for(const metric of quick){
   const node=section.querySelector<HTMLElement>('[data-quick-value="'+metric.id+'"]');
   const quality=section.querySelector<HTMLElement>('[data-quick-quality="'+metric.id+'"]');
   const reading=response.readings[metric.id];
   const valid=reading&&reading.value!==null&&reading.quality!=='missing'&&reading.quality!=='suspect';
   if(node)node.textContent=valid?formatValue(reading.value,metric.digits):'—';
   if(quality)quality.textContent=valid?'Platné měření':reading?.quality==='suspect'?'Podezřelý údaj':'Nedostupné měření';
  }
  if(lastLiveEvent)applyLive(lastLiveEvent);
 }).catch(()=>{
  if(controller.signal.aborted)return;
  if(status){status.textContent='API nedostupné';status.classList.add('error');}
  if(updated)updated.textContent='Archivní měření se znovu načítá; živý zdroj není dostupný.';
  if(provenance)provenance.textContent='Přechod na původní archiv WeeWX · opakované načtení při dočasné nedostupnosti API.';
  if(archiveRetryCount<3&&!archiveRetryTimer){
   const delay=4000*(++archiveRetryCount);
   archiveRetryTimer=setTimeout(()=>{
    archiveRetryTimer=undefined;
    if(!controller.signal.aborted)void refresh();
   },delay);
  }else if(archiveRetryCount>=3&&updated){
   updated.textContent='Archivní API je dočasně nedostupné. Zkuste stránku obnovit.';
  }
 });
 // Live readings are displayed only for metrics present in the authenticated
 // custom upload. Archive-only interval rain is never confused with gateway rain totals.
 const applyLive=(event:Event)=>{
  if(controller.signal.aborted)return;
  const data=(event as CustomEvent<{state:string;receivedAt:string;observedAt:string;units:string;timestampMeaning?:string;
   readings:Record<string,{value:number;quality:string;source:string}>}>).detail;
  const received=Date.parse(data?.receivedAt??'');
  if(data?.state!=='live'||data.units!=='metricwx'||!Number.isFinite(received)||
   Date.now()-received>120000)return;
  lastLiveEvent=event;
  const readings=data.readings??{};
  const all=[...metrics,{id:'rain',digits:1},{id:'radiation',digits:0},{id:'UV',digits:1},{id:'pm25_1',digits:1}];
  for(const metric of all){
   const reading=readings[metric.id];
   if(!reading||reading.source!=='gw3000_live'||reading.quality!=='measured'||
    typeof reading.value!=='number'||!Number.isFinite(reading.value))continue;
   const node=section.querySelector<HTMLElement>('[data-metric-value="'+metric.id+'"]')??
    section.querySelector<HTMLElement>('[data-quick-value="'+metric.id+'"]');
   const quality=section.querySelector<HTMLElement>('[data-metric-quality="'+metric.id+'"]')??
    section.querySelector<HTMLElement>('[data-quick-quality="'+metric.id+'"]');
   if(node)node.textContent=formatValue(reading.value,metric.digits);
   if(quality){quality.textContent='Živé měření GW3000';quality.dataset.readingState='measured';}
  }
  if(status){status.textContent='GW3000 · živá měření';status.className='status-chip ok';}
  if(provenance)provenance.textContent='Živá data GW3000 přes lokální API · pouze právě dostupné veličiny; ostatní hodnoty z archivu WeeWX.';
  if(updated)updated.textContent=(data.timestampMeaning==='gateway_polled_at'?'GW3000 · přečteno ':'GW3000 · naměřeno ')+formatTimestamp(data.observedAt)+
   ' · nezahrnuté veličiny z posledního archivu WeeWX';
 };
 const restoreArchive=()=>{
  lastLiveEvent=undefined;
  archiveRetryCount=0;
  if(archiveRetryTimer){clearTimeout(archiveRetryTimer);archiveRetryTimer=undefined;}
  if(!controller.signal.aborted)void refresh();
 };
 if(section){
  void refresh();
  window.addEventListener('loucka:archive-updated',()=>{if(!controller.signal.aborted)void refresh();});
  window.addEventListener('loucka:live-observation',applyLive);
  window.addEventListener('loucka:live-expired',restoreArchive);
 }
 document.addEventListener('astro:before-swap',()=>{
  window.removeEventListener('loucka:live-observation',applyLive);
  window.removeEventListener('loucka:live-expired',restoreArchive);
  if(archiveRetryTimer){clearTimeout(archiveRetryTimer);archiveRetryTimer=undefined;}
 },{once:true});
 document.addEventListener('astro:before-swap',()=>controller.abort(),{once:true});
</script>
