---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasNav from '../features/climate/AtlasNav.astro';
import ClimateHighlights from '../features/climate/ClimateHighlights.astro';
import ClimateDashboard from '../features/climate/ClimateDashboard.astro';
import YearComparison from '../features/climate/YearComparison.astro';
import AllYearsTemperature from '../features/climate/AllYearsTemperature.astro';
---
<BaseLayout title="Klimatologický atlas Loučky"
 description="Klimatologický atlas Loučky: extrémy, roční trendy, srovnání sezón a meteorologické ročenky z původního archivu od roku 2009.">
 <div class="climate-atlas">
  <header class="atlas-edition-hero">
   <p class="atlas-eyebrow">Počasí Loučka · meteorologický archiv od roku 2009</p>
   <h1 class="atlas-title">Klimatologický atlas Loučky</h1>
   <p class="atlas-subtitle">Co si Loučka pamatuje o svém počasí? Prozkoumej výjimečné dny, porovnej roční období, sleduj dlouhodobý vývoj a sestav si osobní meteorologickou ročenku.</p>
  </header>
  <AtlasNav active="prehled" />
  <div class="atlas-chapter-heading">
   <div>
    <p class="atlas-eyebrow">Prozkoumat původní archiv</p>
    <h2 id="atlas-chapters-title">Vyber si kapitolu</h2>
   </div>
   <p>Čtyři cesty do historie počasí v Loučce.</p>
  </div>
  <div class="climate-atlas-grid" aria-labelledby="atlas-chapters-title">
   <a class="climate-atlas-card" href="/klimatologie/extremy/">
    <span class="number">01 / HISTORICKÉ MILNÍKY</span>
    <h3>Extrémy</h3>
    <p>Nejnižší a nejvyšší naměřená teplota, srážkové epizody, vítr a významné kalendářní dny.</p>
    <span class="chapter-link">Prozkoumat rekordy</span>
   </a>
   <a class="climate-atlas-card" href="/klimatologie/trendy/">
    <span class="number">02 / VÝVOJ V ČASE</span>
    <h3>Trendy</h3>
    <p>Roční souhrny, srážkový atlas, pokrytí historické vlhkosti a popis změn teploty, srážek a větru.</p>
    <span class="chapter-link">Otevřít trendy</span>
   </a>
   <a class="climate-atlas-card" href="/klimatologie/sezony/">
    <span class="number">03 / KALENDÁŘ POČASÍ</span>
    <h3>Srovnání sezón</h3>
    <p>Porovnej dvě jara, léta, podzimy nebo zimy na společně dostupných dnech.</p>
    <span class="chapter-link">Vybrat roční období</span>
   </a>
   <a class="climate-atlas-card" href="/klimatologie/rocenka/">
    <span class="number">04 / OSOBNÍ ARCHIV</span>
    <h3>Meteorologická ročenka</h3>
    <p>Vytvoř přehled konkrétního roku z doložených měření a vytiskni jej do PDF.</p>
    <span class="chapter-link">Vytvořit ročenku</span>
   </a>
  </div>
  <ClimateHighlights />
  <p class="climate-atlas-note">Starší měření nejsou vždy úplná. U rekordů a dlouhodobých srovnání proto ber výsledky jako orientační.</p>
  <details class="climate-atlas-data-note">
   <summary>Jak pracujeme s historickými údaji?</summary>
   <p class="source-note">Používáme původní denní souhrny WeeWX. Některá období mají výpadky nebo neověřené anomálie; nejde o certifikované klimatologické normály. Chybějící hodnoty nenahrazujeme nulami.</p>
  </details>
  <p class="source-note"><a href="/klimatologie/trendy/#srazky-archiv">Prozkoumat srážkové úhrny a známá omezení.</a> · <a href="/klimatologie/trendy/#vlhkost-archiv">Dostupnost historické vlhkosti a výpadky měření.</a></p>
  <details class="atlas-legacy-area atlas-deep-dive" id="datovy-archiv" data-climate-deep-dive>
   <summary class="atlas-deep-dive-summary">
    <span class="atlas-deep-dive-intro">
     <strong>Podrobná analýza a srovnání let</strong>
     <small>Roční přehledy, grafy teplot, heatmapy a porovnání dvou roků</small>
    </span>
    <span class="atlas-deep-dive-action" aria-hidden="true"><span class="atlas-action-closed">Otevřít analýzu</span><span class="atlas-action-open">Zavřít analýzu</span></span>
   </summary>
   <div class="atlas-deep-dive-body">
   <h2 class="atlas-section-heading">Porovnej počasí podle roku</h2>
   <p class="source-note">Vyber si, co tě zajímá. Nemusíš procházet všechny grafy jeden po druhém.</p>
   <nav class="atlas-quick-links" aria-label="Přejít rovnou na vybrané grafy">
    <a href="#teplota-vsechny-roky">Teploty napříč roky</a>
    <a href="#srovnani-let">Porovnat dva roky</a>
    <a href="/grafy/">Vybrat vlastní období</a>
   </nav>
   <details class="atlas-expert-section" data-climate-subsection="summary" open>
    <summary><strong>Roční a měsíční přehledy</strong><span>Souhrny, měsíční teploty, srážky a vítr</span></summary>
    <div class="atlas-expert-content"><ClimateDashboard /></div>
   </details>
   <details class="atlas-expert-section" data-climate-subsection="temperatures">
    <summary><strong>Teploty napříč roky</strong><span>Historické roky v jednom srovnání</span></summary>
    <div class="atlas-expert-content"><AllYearsTemperature /></div>
   </details>
   <details class="atlas-expert-section" data-climate-subsection="comparison">
    <summary><strong>Porovnání dvou roků</strong><span>Interaktivní grafy, kalendáře a podrobné hodnoty</span></summary>
    <div class="atlas-expert-content"><YearComparison /></div>
   </details>
   </div>
  </details>
 </div>
</BaseLayout>
<script>
 const analysis=document.querySelector<HTMLDetailsElement>('[data-climate-deep-dive]');
 if(analysis){
  const revealFragment=()=>{
   let id='';
   try{id=decodeURIComponent(window.location.hash.slice(1));}catch{return;}
   if(!id)return;
   const target=document.getElementById(id);
   if(id==='datovy-archiv'||(target&&analysis.contains(target))){
    analysis.open=true;
    // Reveal all nested native disclosures above the target, preserving
    // the historical #teplota-vsechny-roky / #srovnani-let deep links.
    if(target){
     let node=target.parentElement;
     while(node&&node!==analysis){
      if(node instanceof HTMLDetailsElement)node.open=true;
      node=node.parentElement;
     }
     requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));
    }
   }
  };
  revealFragment();
  window.addEventListener('hashchange',revealFragment);
  document.addEventListener('astro:before-swap',()=>window.removeEventListener('hashchange',revealFragment),{once:true});
 }
</script>
