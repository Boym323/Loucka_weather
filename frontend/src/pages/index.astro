---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentPanel from '../features/current/CurrentPanel.astro';
import DailySummaryStrip from '../features/current/DailySummaryStrip.astro';
import HistoryChart from '../features/history/HistoryChart.astro';
import OverviewReadings from '../features/current/OverviewReadings.astro';
import ForecastPanel from '../features/forecast/ForecastPanel.astro';
import RadarPanel from '../features/maps/RadarPanel.astro';
---
<BaseLayout title="Přehled" description="Počasí Loučka: skutečná data meteostanice, aktuální předpověď, grafy, webkamera a radar.">
 <section class="site-banner" aria-label="Pohled západní kamerou na Loučku; čas pořízení snímku nebyl ověřen">
  <img class="banner-scene" src="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" alt="" aria-hidden="true" loading="eager" />
  <div class="banner-copy"><strong>Počasí Loučka</strong><span>Aktuální měření · lokální meteostanice ve Zlínském kraji</span></div>
  <small class="illustration-label">Kamera Loučka · čas snímku neověřen</small>
 </section>
 <div class="dashboard-top">
  <div class="dashboard-primary">
   <CurrentPanel variant="dashboard" />
   <DailySummaryStrip />
   <div class="home-quick-links" aria-label="Další údaje">
    <a href="/aktualne/"><span aria-hidden="true">◉</span> Podrobné aktuální údaje <span aria-hidden="true">↗</span></a>
    <a href="/grafy/"><span aria-hidden="true">⌁</span> Historie a grafy <span aria-hidden="true">↗</span></a>
    <a href="/senzory/"><span aria-hidden="true">▥</span> Senzory <span aria-hidden="true">↗</span></a>
   </div>
  </div>
  <aside class="sidebar-stack" aria-label="Předpověď a doplňková meteorologická data">
   <ForecastPanel compact />
   <div class="dashboard-side-notes">
    <section class="note-panel warning-panel" aria-label="Výstrahy ČHMÚ">
     <div class="panel-title"><span aria-hidden="true">⚠</span> Výstrahy ČHMÚ <span class="status-chip">Stav neověřen</span></div>
     <p>Bez napojení oficiálního zdroje nemůžeme potvrdit ani vyloučit platné výstrahy.</p>
    </section>
    <OverviewReadings />
   </div>
  </aside>
 </div>
 <div class="dashboard-bottom">
  <HistoryChart compact />
  <section class="section camera-preview-panel">
   <div class="section-heading"><div class="panel-title"><span class="panel-mark" aria-hidden="true">▣</span> Webkamera Loučka – západ</div><a class="panel-link" href="/kamera/">Kamera ↗</a></div>
   <a class="camera-image home-camera-image" href="/kamera/" aria-label="Otevřít aktuální snímek kamery">
    <img src="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" alt="Webkamera Loučka směrem na západ" loading="lazy" />
   </a>
   <div class="preview-footer"><span class="source-note">Snímek z kamery · čas pořízení nebyl ověřen</span><a class="panel-link" href="/kamera/">Zobrazit detail ↗</a></div>
  </section>
  <RadarPanel compact />
 </div>
</BaseLayout>
