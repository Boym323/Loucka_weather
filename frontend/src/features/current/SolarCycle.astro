<section class="observatory-sky" data-solar-cycle aria-labelledby="solar-heading">
 <div class="observatory-module-head">
  <div><span class="observatory-kicker">SVĚTLO A ČAS</span><h2 id="solar-heading">Slunce a Měsíc</h2></div>
  <span class="observatory-small-tag">Astronomický výpočet</span>
 </div>
 <div class="solar-arc" aria-hidden="true">
  <svg viewBox="0 0 500 118" preserveAspectRatio="xMidYMax meet">
   <path class="solar-arc-track" d="M30 101 Q250 -91 470 101"/>
   <path class="solar-arc-horizon" d="M16 101H484"/>
   <circle class="solar-arc-sun" data-solar-sun cx="30" cy="101" r="12"/>
   <circle class="solar-arc-sun-core" data-solar-core cx="30" cy="101" r="4"/>
  </svg>
 </div>
 <div class="solar-times">
  <div><span>Východ</span><strong data-solar-rise>—</strong></div>
  <div><span>Délka dne</span><strong data-solar-length>—</strong></div>
  <div><span>Západ</span><strong data-solar-set>—</strong></div>
 </div>
 <div class="solar-moon-line">
  <span class="solar-moon-glyph" aria-hidden="true">☾</span>
  <span data-moon-description>Fáze Měsíce se počítá…</span>
  <strong data-moon-illumination>—</strong>
 </div>
 <p class="observatory-source-note" data-solar-note>Orientační výpočet pro polohu obce Loučka, nikoli naměřené hodnoty; místní terén může skutečný východ a západ ovlivnit.</p>
</section>
<script>
 import {solarDay,lunarPhase} from '../../shared/domain/astronomy';
 const element=document.querySelector<HTMLElement>('[data-solar-cycle]');
 if(element){
  const controller=new AbortController();
  const dateParts=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Prague',
   year:'numeric',month:'2-digit',day:'2-digit'});
  const localDate=(at:Date)=>{
   const items=Object.fromEntries(dateParts.formatToParts(at).map(p=>[p.type,p.value]));
   return items.year+'-'+items.month+'-'+items.day;
  };
  const time=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',hour:'2-digit',minute:'2-digit'});
  const set=(key:string,value:string)=>{
   const target=element.querySelector<HTMLElement>('[data-'+key+']');
   if(target)target.textContent=value;
  };
  const draw=()=>{
   if(controller.signal.aborted)return;
   const now=new Date();
   const sun=solarDay(localDate(now));
   if(sun){
    set('solar-rise',time.format(sun.sunrise));
    set('solar-set',time.format(sun.sunset));
    set('solar-length',Math.floor(sun.dayLengthMinutes/60)+' h '+sun.dayLengthMinutes%60+' min');
    const fraction=Math.max(0,Math.min(1,(now.getTime()-sun.sunrise.getTime())/
     (sun.sunset.getTime()-sun.sunrise.getTime())));
    const x=30+440*fraction,y=101-384*fraction*(1-fraction);
    for(const attr of ['solar-sun','solar-core']){
     const target=element.querySelector<SVGElement>('[data-'+attr+']');
     if(target){target.setAttribute('cx',x.toFixed(1));target.setAttribute('cy',y.toFixed(1));}
    }
    const night=now<sun.sunrise||now>sun.sunset;
    element.dataset.solarNight=String(night);
    const state=now<sun.sunrise?'Slunce ještě nevyšlo':now>sun.sunset?'Po západu slunce':'Probíhá denní světlo';
    set('solar-note',state+' · Orientační výpočet pro polohu obce Loučka, nikoli měření stanice. Terén a atmosféra ovlivňují skutečné časy.');
   }else{
    set('solar-note','Sluneční časy nejsou pro dnešní datum k dispozici.');
   }
   const moon=lunarPhase(now);
   set('moon-description',moon.name+' · přibližná fáze');
   set('moon-illumination',Math.round(moon.illuminated*100)+' %');
  };
  draw();
  const timer=setInterval(draw,60_000);
  document.addEventListener('astro:before-swap',()=>{controller.abort();clearInterval(timer);},{once:true});
 }
</script>