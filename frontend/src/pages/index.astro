---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentPanel from '../features/current/CurrentPanel.astro';
import DailySummaryStrip from '../features/current/DailySummaryStrip.astro';
import HistoryChart from '../features/history/HistoryChart.astro';
import OverviewReadings from '../features/current/OverviewReadings.astro';
import ForecastPanel from '../features/forecast/ForecastPanel.astro';
import RadarPanel from '../features/maps/RadarPanel.astro';
import LocalWarnings from '../features/alerts/LocalWarnings.astro';
import SiteIcon from '../shared/ui/SiteIcon.astro';
---
<BaseLayout title="Přehled" description="Počasí Loučka: živá měření GW3000, původní archiv WeeWX, předpověď, grafy, kamera a radar.">
 <div class="atlas-home">
  <header class="atlas-home-intro">
   <div>
    <span class="atlas-location"><SiteIcon name="map-pin" size={16} /> Loučka, okres Zlín</span>
    <h1>Počasí právě teď</h1>
    <p>Měření z vlastní meteorologické stanice · údaje s uvedením původu a času</p>
   </div>
   <a class="atlas-intro-link" href="/aktualne/">Všechna aktuální měření <span aria-hidden="true">↗</span></a>
  </header>
  <section class="atlas-hero" aria-label="Aktuální počasí v Loučce">
   <div class="atlas-hero-top">
    <CurrentPanel variant="dashboard"/>
   </div>
   <aside class="atlas-hero-daily" aria-label="Dnešní archivní minima, maxima a srážky">
    <DailySummaryStrip />
   </aside>
  </section>

  <div class="atlas-alert-line"><LocalWarnings compact /></div>

  <div class="atlas-home-analytics">
   <div class="atlas-main-history"><HistoryChart compact /></div>
   <div class="atlas-forecast"><ForecastPanel compact /></div>
   <div class="atlas-home-extras"><OverviewReadings /></div>
  </div>

  <div class="atlas-media-row">
   <section class="atlas-media-card atlas-camera-tile" aria-labelledby="atlas-camera-title">
    <a class="atlas-media-image" href="/kamera/" aria-label="Otevřít detail webkamery Loučka">
     <img src="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" alt="Webkamera Loučka, západní směr; čas pořízení neověřen" loading="lazy" decoding="async"/>
     <span class="atlas-media-overlay"><strong id="atlas-camera-title">Webkamera</strong><span aria-hidden="true">↗</span></span>
    </a>
    <p>Snímek ze západní kamery · čas pořízení nebyl ověřen</p>
   </section>
   <div class="atlas-media-card atlas-radar-tile">
    <RadarPanel compact />
   </div>
  </div>

  <nav class="atlas-home-destinations" aria-label="Prozkoumat meteorologická data">
   <a href="/aktualne/"><span class="atlas-dest-icon"><SiteIcon name="weather" size={20}/></span><span><strong>Detailní měření</strong><small>Všechny dostupné veličiny</small></span><span aria-hidden="true">↗</span></a>
   <a href="/grafy/"><span class="atlas-dest-icon"><SiteIcon name="chart" size={20}/></span><span><strong>Grafy a historie</strong><small>Průběh a porovnání</small></span><span aria-hidden="true">↗</span></a>
   <a href="/klimatologie/"><span class="atlas-dest-icon"><SiteIcon name="archive" size={20}/></span><span><strong>Klimatologie</strong><small>Dlouhodobé statistiky</small></span><span aria-hidden="true">↗</span></a>
   <a href="/rekordy/"><span class="atlas-dest-icon"><SiteIcon name="record" size={20}/></span><span><strong>Rekordy</strong><small>Extrémy s ověřením původu</small></span><span aria-hidden="true">↗</span></a>
   <a href="/senzory/"><span class="atlas-dest-icon"><SiteIcon name="sensors" size={20}/></span><span><strong>Senzory</strong><small>Kanály a dostupnost</small></span><span aria-hidden="true">↗</span></a>
   <a href="/o-stanici/"><span class="atlas-dest-icon"><SiteIcon name="info" size={20}/></span><span><strong>O stanici</strong><small>Technologie a metodika</small></span><span aria-hidden="true">↗</span></a>
  </nav>
 </div>
</BaseLayout>
