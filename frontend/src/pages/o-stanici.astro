---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeploymentInfo from '../shared/ui/DeploymentInfo.astro';
import StationTimeline from '../features/history/StationTimeline.astro';
---
<BaseLayout title="O projektu">
 <div class="page-intro"><span class="eyebrow">O meteorologické stanici</span><h1>O projektu Počasí Loučka</h1><p>Místní měření a přehled počasí z Loučky a okolí.</p></div>
 <div class="about-layout">
  <section class="section about-image"><a href="/kamera/" aria-label="Otevřít webkameru Loučka"><img src="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" alt="Západní pohled z webkamery meteorologické stanice Loučka" loading="lazy" /></a><span class="source-note">Skutečná západní webkamera · čas pořízení snímku není ověřen</span></section>
  <section class="section about-main"><span class="eyebrow">Meteorologická stanice</span><h2>Počasí Loučka</h2><p class="lead">Místní stanice sleduje počasí v Loučce a zpřístupňuje současná i archivní měření. Historie měření sahá do roku 2009.</p><div class="about-facts"><div><strong>2009</strong><span>První záznam</span></div><div><strong>Loučka</strong><span>Místo měření</span></div></div></section>
 </div>
 <StationTimeline />
 <section class="section about-tech"><div class="section-heading"><div><span class="eyebrow">O datech</span><h2>Jak web funguje</h2></div></div><div class="about-tech-grid"><div><strong>Archiv měření</strong><p>Starší měření si můžeš prohlédnout od roku 2009. Tehdejší web běžel na Cumulusu; dnes údaje zpřístupňuje archiv WeeWX. Přechod starších dat stále ověřujeme.</p></div><div><strong>Aktuální údaje</strong><p>Stránka zobrazuje poslední dostupný archivní záznam a upozorní na zastaralá data.</p></div><div><strong>Grafy a historie</strong><p>Pokud měření chybí, graf nechá mezeru. Všechny časy ukazujeme místně.</p></div><div><strong>Webkamera</strong><p>Aktuální snímek zachycuje pohled západním směrem.</p><a class="panel-link" href="/kamera/">Zobrazit kameru ↗</a></div></div></section>
 <section class="section about-deployment" aria-labelledby="deployment-heading">
  <details>
   <summary id="deployment-heading">Informace o verzi webu</summary>
   <p class="source-note">Tato stránka je vývojový náhled. Níže najdeš číslo skutečně nasazené verze a odkaz na změny v GitHubu.</p>
   <DeploymentInfo detailed />
  </details>
 </section>
</BaseLayout>
