<section class="section" data-rain-detail aria-labelledby="rain-detail-title">
 <div class="section-heading">
  <div><span class="eyebrow">Srážky · archivní intervaly</span><h2 id="rain-detail-title">Srážky za posledních 24 hodin</h2></div>
  <div class="rain-actions"><span class="status-chip" data-rain-status role="status">Načítání</span><button type="button" class="chart-tab" data-rain-retry>Obnovit</button></div>
 </div>
 <div class="rain-detail-chart" data-rain-chart role="img" aria-label="Sloupcový graf srážek z archivních intervalů"></div>
 <div class="chart-summary" data-rain-summary></div>
 <p class="source-note">Součet je pouze z dostupných intervalů; při mezerách v archivu nemusí odpovídat úplnému dennímu úhrnu.</p>
</section>
<script>
 import {getHistory24h} from '../../shared/api/client';
 import {formatValue} from '../../shared/domain/metrics';
 import * as echarts from 'echarts/core';
 import { BarChart } from 'echarts/charts';
 import { GridComponent, TooltipComponent } from 'echarts/components';
 import { SVGRenderer } from 'echarts/renderers';
 echarts.use([BarChart,GridComponent,TooltipComponent,SVGRenderer]);
 const root=document.querySelector<HTMLElement>('[data-rain-detail]');
 const target=root?.querySelector<HTMLElement>('[data-rain-chart]');
 const status=root?.querySelector<HTMLElement>('[data-rain-status]');
 const summary=root?.querySelector<HTMLElement>('[data-rain-summary]');
 const retry=root?.querySelector<HTMLButtonElement>('[data-rain-retry]');
 if(target){
  const chart=echarts.init(target,undefined,{renderer:'svg'});
  const observer=new ResizeObserver(()=>chart.resize());observer.observe(target);
  const controller=new AbortController();
  let loading=false;
  const load=async()=>{
   if(loading||controller.signal.aborted)return;
   loading=true;if(retry)retry.disabled=true;
   if(status){status.textContent='Ověřuji srážky…';status.className='status-chip';}
   if(summary)summary.textContent='Načítám skutečné intervalové úhrny.';
   try{
   const result=await getHistory24h('rain',controller.signal);
   const values=result.points.map(p=>[
    Date.parse(p.endTime),
    p.value===null||p.quality==='missing'||p.quality==='suspect'?null:p.value
   ] as [number,number|null]);
   const compact=window.matchMedia('(max-width:650px)').matches;
   const light=document.documentElement.dataset.theme!=='dark';
   const ink=light?'#4b625e':'#bbd0cc',gridColor=light?'#e2e9e6':'#3a5054';
   const color=light?'#2879a3':'#8dc7e4';
   const clock=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',hour:'2-digit',minute:'2-digit'});
   chart.clear();
   chart.setOption({
    backgroundColor:'transparent',animation:false,
    grid:{top:22,bottom:compact?45:52,left:compact?42:52,right:compact?12:22},
    tooltip:{trigger:'axis',confine:true},
    xAxis:{type:'time',splitNumber:compact?3:7,
     axisLabel:{color:ink,fontSize:compact?10:12,hideOverlap:true,
      showMinLabel:false,showMaxLabel:false,formatter:(v:number)=>clock.format(new Date(v))},
     axisTick:{show:false},axisLine:{lineStyle:{color:gridColor}},splitLine:{show:false}},
    yAxis:{type:'value',min:0,name:'mm',splitNumber:4,
     nameTextStyle:{color:ink,fontSize:11},axisLabel:{color:ink,fontSize:compact?10:12},
     axisLine:{show:false},axisTick:{show:false},
     splitLine:{lineStyle:{color:gridColor,type:'solid'}}},
    series:[{name:'Intervalový úhrn',type:'bar',data:values,itemStyle:{color},
     barMaxWidth:compact?8:14}]
   });
   const valid=values.filter((p):p is [number,number]=>p[1]!==null&&Number.isFinite(p[1]));
   const hasGaps=values.length===0||values.some(p=>p[1]===null);
   if(status){status.textContent=valid.length?' '+valid.length+' platných intervalů':'Bez potvrzených intervalů';status.className='status-chip '+(valid.length?'ok':'warning');}
   if(summary){
    const total=valid.reduce((acc,p)=>acc+p[1],0);
    summary.textContent='Součet naměřených intervalů: '+formatValue(total,1)+' mm'+(hasGaps?' · neúplné pokrytí':'');
   }
   chart.resize();
   }catch(error){
    if(controller.signal.aborted)return;
    if(status){status.textContent='Historie nedostupná';status.className='status-chip error';}
    if(summary)summary.textContent='Načtení intervalů selhalo. Zkus Obnovit; chyba: '+(error instanceof Error?error.message:'nedostupné API');
   }finally{loading=false;if(retry)retry.disabled=false;}
  };
  retry?.addEventListener('click',()=>void load());
  // Do not compete with the large advanced-history request during initial navigation.
  const initial=setTimeout(()=>void load(),2200);
  const themeChanged=()=>void load();
  window.addEventListener('loucka:theme-change',themeChanged);
  document.addEventListener('astro:before-swap',()=>{
   clearTimeout(initial);controller.abort();observer.disconnect();chart.dispose();
   window.removeEventListener('loucka:theme-change',themeChanged);
  },{once:true});
 }
</script>
