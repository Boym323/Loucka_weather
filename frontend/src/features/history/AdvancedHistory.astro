---
import '../../styles/history-table.css';
---
<section class="section advanced-history" data-advanced-history aria-labelledby="advanced-history-heading">
 <div class="section-heading">
  <div><span class="eyebrow">Vyber si období a měření</span><h2 id="advanced-history-heading">Podrobný historický graf</h2></div>
  <span class="status-chip" data-advanced-status role="status">Načítám</span>
 </div>
 <div class="history-presets" role="group" aria-label="Rychlý výběr časového období">
  <button type="button" class="chart-tab" data-period="today">Dnes</button>
  <button type="button" class="chart-tab" data-period="yesterday">Včera</button>
  <button type="button" class="chart-tab" data-period="7d" aria-pressed="true">7 dní</button>
  <button type="button" class="chart-tab" data-period="30d">30 dní</button>
  <button type="button" class="chart-tab" data-period="this-year">Letos</button>
  <button type="button" class="chart-tab" data-period="year">Minulý rok</button>
 </div>
 <p class="source-note">Rychlé volby používají kalendářní dny v místním čase Loučky.</p>
 <form class="advanced-history-form" data-history-form>
  <label>Od <input type="date" name="from" required min="2009-01-01" /></label>
  <label>Do <input type="date" name="to" required min="2009-01-01" /></label>
  <label>Veličina
   <select name="metric">
    <option value="outTemp">Teplota (°C)</option>
    <option value="outHumidity">Vlhkost (%)</option>
    <option value="barometer">Tlak (hPa)</option>
    <option value="windSpeed">Vítr (m/s)</option>
    <option value="windGust">Nárazy větru (m/s)</option>
    <option value="rain">Srážky (mm)</option>
    <option value="rainRate">Intenzita srážek (mm/h)</option>
    <option value="radiation">Sluneční záření (W/m²)</option>
    <option value="pm25_1">PM2,5 (µg/m³)</option>
   </select>
  </label>
  <label>Porovnat s
   <select name="compare">
    <option value="">Bez porovnání</option>
    <option value="outTemp">Teplota</option>
    <option value="outHumidity">Vlhkost</option>
    <option value="barometer">Tlak</option>
    <option value="windSpeed">Rychlost větru</option>
    <option value="windGust">Nárazy</option>
    <option value="rain">Srážky</option>
    <option value="radiation">Záření</option>
   </select>
  </label>
  <button class="history-apply" type="submit">Zobrazit</button>
  <button class="history-export" type="button" data-history-export disabled>Stáhnout CSV</button>
 </form>
 <p class="sr-only" data-history-zoom-status role="status">Časová osa zatím není dostupná.</p>
 <div class="advanced-history-chart" data-advanced-canvas role="img" aria-label="Dynamický časový graf archivních měření"></div>
 <div class="history-zoom-controls" role="group" aria-label="Přiblížení časové osy grafu">
  <button type="button" class="chart-tab" data-history-zoom="in" disabled>Přiblížit</button>
  <button type="button" class="chart-tab" data-history-zoom="out" disabled>Oddálit</button>
  <button type="button" class="chart-tab" data-history-zoom="reset" disabled>Celé období</button>
 </div>
 <p class="source-note history-zoom-hint">Časovou osu upravíš tlačítky nebo posuvníkem pod grafem. Tlačítka lze ovládat i klávesnicí; všechny hodnoty najdeš v tabulce níže.</p>
 <div class="advanced-history-feedback" data-advanced-feedback hidden role="status">
  <span data-advanced-feedback-text>Graf není dostupný.</span>
  <button type="button" class="chart-retry" data-advanced-retry>Zkusit znovu</button>
 </div>
 <div class="chart-summary" data-advanced-summary aria-live="polite"></div>
 <p class="source-note" data-history-quality-note>Mezery znamenají chybějící nebo nejistá měření. Podrobnosti o každém bodu uvidíš po najetí nebo klepnutí; dostupná je i kompletní tabulka hodnot.</p>
 <details class="history-table-alternative" data-advanced-table>
  <summary>Zobrazit hodnoty grafu v tabulce</summary>
  <div class="table-scroll" role="region" aria-label="Hodnoty historického grafu v tabulce" tabindex="0">
   <table class="history-table">
    <thead><tr><th scope="col">Konec intervalu</th><th scope="col">Veličina</th><th scope="col">Hodnota</th><th scope="col">Kvalita</th><th scope="col">Zdroj</th></tr></thead>
    <tbody data-advanced-table-body><tr><td colspan="5">Hodnoty se zobrazí po načtení grafu.</td></tr></tbody>
   </table>
  </div>
 </details>
 <details class="history-data-details">
  <summary>Jak číst graf a odkud údaje pocházejí?</summary>
  <p class="source-note">Rozlišujeme naměřené, odvozené a rekonstruované hodnoty. Údaje zobrazujeme v místním čase včetně změn letního a zimního času. U delších období používáme hodinové nebo denní souhrny; CSV obsahuje skutečně vrácené hodnoty včetně označení kvality.</p>
  <p class="source-note" data-history-quality-summary>Počty jednotlivých druhů měření se zobrazí po načtení grafu.</p>
 </details>
</section>
<script>
 import {getHistoryInterval} from '../../shared/api/client';
 import {pragueMidnightIso,nextDate} from '../../shared/domain/statistics';
 import {formatMetricValue,metricAxisStep} from '../../shared/domain/metrics';
 import type {HistoryResponse} from '../../shared/domain/weather';
 import {validHistoryPoint as valid,historyQualityName as qualityName,escapeChartHtml as escapeHtml,summarizeHistorySeries,historyAxisPoints,historyTotals} from '../../shared/domain/history-chart-model';
 import * as echarts from 'echarts/core';
 import {LineChart,BarChart} from 'echarts/charts';
 import {GridComponent,TooltipComponent,LegendComponent,DataZoomComponent} from 'echarts/components';
 import {SVGRenderer} from 'echarts/renderers';
 echarts.use([LineChart,BarChart,GridComponent,TooltipComponent,LegendComponent,DataZoomComponent,SVGRenderer]);
 const root=document.querySelector<HTMLElement>('[data-advanced-history]')!;
 if(root){
  const form=root.querySelector<HTMLFormElement>('[data-history-form]')!;
  const canvas=root.querySelector<HTMLElement>('[data-advanced-canvas]')!;
  const status=root.querySelector<HTMLElement>('[data-advanced-status]');
  const summary=root.querySelector<HTMLElement>('[data-advanced-summary]');
  const feedback=root.querySelector<HTMLElement>('[data-advanced-feedback]');
  const feedbackText=root.querySelector<HTMLElement>('[data-advanced-feedback-text]');
  const retry=root.querySelector<HTMLButtonElement>('[data-advanced-retry]');
  const qualitySummary=root.querySelector<HTMLElement>('[data-history-quality-summary]');
  const exportButton=root.querySelector<HTMLButtonElement>('[data-history-export]');
  const tableDetails=root.querySelector<HTMLDetailsElement>('[data-advanced-table]');
  const tableBody=root.querySelector<HTMLTableSectionElement>('[data-advanced-table-body]');
  const chart=echarts.init(canvas,undefined,{renderer:'svg'});
  const observer=new ResizeObserver(()=>chart.resize());observer.observe(canvas);
  const formatter=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Prague',year:'numeric',month:'2-digit',day:'2-digit'});
  const localDate=(date:Date)=>formatter.format(date);
  let activeRange='7d',controller:AbortController|undefined,results:HistoryResponse[]=[];
  const zoomButtons=[...root.querySelectorAll<HTMLButtonElement>('[data-history-zoom]')];
  const zoomStatus=root.querySelector<HTMLElement>('[data-history-zoom-status]');
  const setZoomEnabled=(enabled:boolean)=>{
   for(const button of zoomButtons)button.disabled=!enabled;
  };
  // The ECharts slider and the native buttons operate on the same time-axis
  // percentage window. No fetched or reconstructed measurement is modified.
  const zoomWindow=()=>{
   const options=chart.getOption() as {dataZoom?:Array<{start?:number;end?:number}>};
   const window=options.dataZoom?.[0];
   return {
    start:typeof window?.start==='number'?window.start:0,
    end:typeof window?.end==='number'?window.end:100
   };
  };
  const updateZoomStatus=()=>{
   if(!zoomStatus)return;
   const {start,end}=zoomWindow();
   const share=Math.max(0,Math.min(100,Math.round(end-start)));
   zoomStatus.textContent=share>=99?'Časová osa zobrazuje celé zvolené období.':
    'Časová osa zobrazuje přibližně '+share+' % zvoleného období.';
  };
  const zoomBy=(action:string)=>{
   const {start,end}=zoomWindow();
   const width=Math.max(2,Math.min(100,end-start));
   const nextWidth=action==='in'?Math.max(2,width/2):
    action==='out'?Math.min(100,width*2):100;
   const nextStart=action==='reset'?0:
    Math.max(0,Math.min(100-nextWidth,(start+end-nextWidth)/2));
   chart.dispatchAction({type:'dataZoom',start:nextStart,end:nextStart+nextWidth});
   updateZoomStatus();
  };
  chart.on('datazoom',updateZoomStatus);
  for(const button of zoomButtons){
   button.addEventListener('click',()=>zoomBy(button.dataset.historyZoom??'reset'));
  }
  const tableTimeFormat=new Intl.DateTimeFormat('cs-CZ',{
   dateStyle:'short',timeStyle:'short',timeZone:'Europe/Prague'
  });
  const names:Record<string,string>={
   outTemp:'Teplota',outHumidity:'Vlhkost',barometer:'Tlak',windSpeed:'Vítr',
   windGust:'Nárazy větru',rain:'Srážky',rainRate:'Intenzita srážek',
   radiation:'Sluneční záření',pm25_1:'PM2,5'
  };
  const units:Record<string,string>={
   outTemp:'°C',outHumidity:'%',barometer:'hPa',windSpeed:'m/s',
   windGust:'m/s',rain:'mm',rainRate:'mm/h',radiation:'W/m²',pm25_1:'µg/m³'
  };
  // Render exact API points lazily; never interpolate missing / suspect data.
  function renderDataTable(){
   if(!tableBody||!tableDetails?.open)return;
   const fragment=document.createDocumentFragment();
   for(const result of results){
    for(const point of result.points){
     const row=document.createElement('tr');
     const end=Date.parse(point.endTime);
     const fields=[
      Number.isFinite(end)?tableTimeFormat.format(new Date(end)):'Neznámý čas',
      names[result.metric]??result.metric,
      valid(point)?formatMetricValue(point.value,result.metric,result.unit)+' '+(units[result.metric]??result.unit):'—',
      qualityName(point.quality),
      point.provenance??point.source??'Neurčený'
     ];
     fields.forEach((text,index)=>{
      const cell=row.insertCell();cell.textContent=text;
      if(index===3)cell.dataset.quality=point.quality;
     });
     fragment.append(row);
    }
   }
   if(!fragment.childNodes.length){
    const row=document.createElement('tr'),cell=row.insertCell();
    cell.colSpan=5;cell.textContent='Pro vybrané období nejsou dostupné žádné záznamy.';
    fragment.append(row);
   }
   tableBody.replaceChildren(fragment);
  }
  tableDetails?.addEventListener('toggle',()=>{
   if(tableDetails.open)renderDataTable();
  });
  // Consistent semantically grouped chart palette for both design themes.
  const lightColors:Record<string,string>={
   outTemp:'#176878',outHumidity:'#386e96',barometer:'#665d83',
   windSpeed:'#27785e',windGust:'#27785e',rain:'#2879a3',
   rainRate:'#2879a3',radiation:'#996728',pm25_1:'#795e89'
  };
  const darkColors:Record<string,string>={
   outTemp:'#8dd5c9',outHumidity:'#89bedb',barometer:'#bbacd5',
   windSpeed:'#8dd1b4',windGust:'#8dd1b4',rain:'#8dc7e4',
   rainRate:'#8dc7e4',radiation:'#e2bc76',pm25_1:'#ceaddb'
  };
  const axisClock=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',hour:'2-digit',minute:'2-digit'});
  const axisDay=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',day:'numeric',month:'numeric'});
  const axisMonth=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',month:'short',year:'2-digit'});
  const tooltipTime=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',dateStyle:'medium',timeStyle:'short'});
  const fmtDate=(value:number,days:number)=>(days<=2?axisClock:days<=40?axisDay:axisMonth).format(value);
  const dateInput=(key:string)=>form.elements.namedItem(key) as HTMLInputElement;
  const metricInput=(key:string)=>form.elements.namedItem(key) as HTMLSelectElement;
  // Calendar arithmetic is done on local date strings, not elapsed milliseconds:
  // CET/CEST transitions must not move a preset to a different day.
  const shiftLocalDate=(date:string,offset:number)=>{
   const [year,month,day]=date.split('-').map(Number);
   return new Date(Date.UTC(year,month-1,day+offset)).toISOString().slice(0,10);
  };
  function setPreset(preset:string){
   activeRange=preset;
   const end=localDate(new Date());
   const year=Number(end.slice(0,4));
   let fromDate=end,toDate=end;
   if(preset==='yesterday')fromDate=toDate=shiftLocalDate(end,-1);
   else if(preset==='year'){
    fromDate=(year-1)+'-01-01';toDate=(year-1)+'-12-31';
   }else if(preset==='this-year')fromDate=year+'-01-01';
   else if(preset==='7d'||preset==='30d')
    fromDate=shiftLocalDate(end,1-(preset==='7d'?7:30));
   dateInput('from').value=fromDate;
   dateInput('to').value=toDate;
   root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.period===preset)));
   void refresh();
  }
  async function refresh(){
   controller?.abort();controller=new AbortController();
   const signal=controller.signal;results=[];
   if(tableBody&&tableDetails?.open){
    tableBody.replaceChildren();
    const row=tableBody.insertRow(),cell=row.insertCell();
    cell.colSpan=5;cell.textContent='Načítám aktuální výběr grafu…';
   }
   if(exportButton)exportButton.disabled=true;
   setZoomEnabled(false);
   if(zoomStatus)zoomStatus.textContent='Časová osa se načítá.';
   if(summary)summary.replaceChildren();
   if(feedback)feedback.hidden=true;
   canvas.hidden=false;
   const fromDate=dateInput('from').value,toDate=dateInput('to').value;
   const metric=metricInput('metric').value,compare=metricInput('compare').value;
   try{
    const from=pragueMidnightIso(fromDate),to=pragueMidnightIso(nextDate(toDate));
    const days=Math.round((Date.parse(toDate+'T00:00:00Z')-Date.parse(fromDate+'T00:00:00Z'))/86400000)+1;
    if(!Number.isFinite(days)||days<1||days>731)throw new Error('Vyber období od 1 dne do 2 let.');
    const resolution=days<=2?'raw':days<=40?'hourly':'daily';
    if(status){status.textContent='Načítám graf…';status.className='status-chip';}
    const keys=[...new Set([metric,compare].filter(Boolean))];
    const loaded=await Promise.all(keys.map(k=>getHistoryInterval(k,from,to,resolution,signal)));
    // Do not publish an older request into the shared CSV/table/tooltip state.
    if(signal.aborted)return;
    results=loaded;
    const compact=window.matchMedia('(max-width:650px)').matches;
    const light=document.documentElement.dataset.theme!=='dark';
    const colors=light?lightColors:darkColors;
    const ink=light?'#4b625e':'#bbd0cc';
    const gridColor=light?'#e2e9e6':'#3a5054';
    const primary=light?'#176878':'#8dd5c9';
    const series=results.map((result,index)=>{
     const id=result.metric;
     const color=colors[id]??primary;
     return {
      name:names[id]??id,type:id==='rain'?'bar':'line',
      yAxisIndex:index,data:historyAxisPoints(result.points),
      showSymbol:false,smooth:false,connectNulls:false,barMaxWidth:compact?8:14,
      itemStyle:{color},lineStyle:{width:compact?2:2.5,color},
      emphasis:{focus:'series'},
      areaStyle:undefined
     };
    });
    const yAxis=results.map((result,index)=>({
     type:'value',scale:result.metric!=='rain',min:result.metric==='rain'?0:undefined,
     name:units[result.metric]??result.unit,position:index===0?'left':'right',
     splitNumber:compact?4:5,minInterval:metricAxisStep(result.metric,result.unit),
     nameGap:10,nameTextStyle:{color:ink,fontSize:compact?10:12},
     axisLine:{show:false},axisTick:{show:false},
     axisLabel:{color:ink,fontSize:compact?11:12,hideOverlap:true,margin:compact?8:12,formatter:(value:number)=>formatMetricValue(value,result.metric,result.unit)},
     splitLine:{show:index===0,lineStyle:{color:gridColor,type:'solid',width:1}}
    }));
    chart.clear();
    chart.setOption({
     animation:false,backgroundColor:'transparent',
     color:series.map(s=>s.itemStyle.color),
     legend:{show:series.length>1,top:4,itemWidth:14,itemHeight:3,textStyle:{color:ink,fontSize:11}},
     tooltip:{trigger:'axis',confine:true,
      backgroundColor:light?'#ffffff':'#1a282d',
      borderColor:gridColor,textStyle:{color:light?'#1d302f':'#eff5f3'},
      axisPointer:{type:'line',lineStyle:{color:ink,opacity:.5}},
      formatter:(items:any)=>{
       const rows=Array.isArray(items)?items:items?[items]:[];
       if(!rows.length)return '';
       const first=rows[0];
       const date=tooltipTime.format(new Date(first.value[0]));
       const details=rows.map(item=>{
        const result=results[item.seriesIndex],p=result?.points[item.dataIndex];
        const value=valid(p)?formatMetricValue(p.value,result.metric,result.unit)+' '+(units[result.metric]??result.unit):'—';
        const origin=p?.provenance?` · ${escapeHtml(p.provenance)}`:'';
        return `${item.marker}${escapeHtml(item.seriesName)}: ${value} <small>(${p?qualityName(p.quality):'bez údaje'}${origin})</small>`;
       });
       return `<strong>${escapeHtml(date)}</strong><br>${details.join('<br>')}`;
      }},
     grid:{left:compact?45:56,right:series.length>1?(compact?48:65):(compact?9:24),
      top:series.length>1?48:24,bottom:compact?69:75,containLabel:false},
     xAxis:{type:'time',splitNumber:compact?3:7,boundaryGap:false,
      axisLabel:{color:ink,fontSize:compact?10:12,hideOverlap:true,
       showMinLabel:false,showMaxLabel:false,
       formatter:(value:number)=>fmtDate(value,days)},
      splitLine:{show:false},axisTick:{show:false},
      axisLine:{lineStyle:{color:gridColor}}},
     yAxis,series,
     dataZoom:[
      {type:'inside',zoomOnMouseWheel:false,moveOnMouseWheel:true},
      {type:'slider',height:compact?12:17,bottom:compact?8:10,
       showDetail:false,showDataShadow:true,
       textStyle:{color:ink},borderColor:gridColor,
       fillerColor:light?'rgba(23,104,120,.10)':'rgba(141,213,201,.15)',
       handleStyle:{color:primary,borderColor:primary},
       dataBackground:{lineStyle:{color:gridColor},areaStyle:{color:gridColor}}}
     ]
    },true);
    const summaries=results.map(result=>summarizeHistorySeries(result.points));
    const counts=historyTotals(summaries);
    const total=counts.measured+counts.derived+counts.reconstructed;
    if(status){status.textContent=`Zobrazeno ${total} hodnot · ${counts.missing} mezer`;status.className='status-chip '+(total?'ok':'warning');}
    if(qualitySummary)qualitySummary.textContent=`${counts.measured} měřených, ${counts.derived} odvozených, ${counts.reconstructed} rekonstruovaných a ${counts.missing} chybějících nebo nejistých bodů. Rozlišení grafu: ${resolution}.`+(results.some(r=>r.points.some(p=>p.provenance==='weewx-archive-overlapping-intervals'))?' Časově se překrývající měření nejsou zahrnuta.':'');
    if(summary){
     for(const [index,result] of results.entries()){
      const {minimum,maximum,missing:gaps}=summaries[index]!;
      const span=document.createElement('span');
      if(minimum!==null&&maximum!==null){
       span.textContent=`${names[result.metric]??result.metric}: od ${formatMetricValue(minimum,result.metric,result.unit)} do ${formatMetricValue(maximum,result.metric,result.unit)} ${units[result.metric]??result.unit} · ${gaps} mezer`;
      }else span.textContent=(names[result.metric]??result.metric)+': bez měření';
      summary.append(span);
     }
    }
    if(exportButton)exportButton.disabled=!total;
    setZoomEnabled(total>1);
    if(total>1)updateZoomStatus();
    else if(zoomStatus)zoomStatus.textContent='Pro přiblížení není dostatek platných hodnot.';
    renderDataTable();
    if(!total){
     canvas.hidden=true;
     if(feedback)feedback.hidden=false;
     if(feedbackText)feedbackText.textContent='Pro vybrané období nejsou dostupné platné hodnoty. Zkus změnit veličinu nebo období.';
     if(retry)retry.hidden=true;
    }else if(retry)retry.hidden=false;
    chart.resize();
   }catch(e){
    if(signal.aborted)return;
    results=[];
    chart.clear();
    setZoomEnabled(false);
    if(zoomStatus)zoomStatus.textContent='Časovou osu teď nelze přiblížit.';
    if(status){status.textContent='Historie nedostupná';status.className='status-chip error';}
    canvas.hidden=true;
    if(feedback)feedback.hidden=false;
    if(retry)retry.hidden=false;
    if(feedbackText)feedbackText.textContent=e instanceof Error&&e.message.startsWith('Vyber období')?
     e.message:'Údaje se nepodařilo načíst. Můžeš opakovat požadavek.';
    if(summary)summary.textContent='Zobrazené hodnoty nebyly aktualizovány.';
    renderDataTable();
   }
  }
  retry?.addEventListener('click',()=>void refresh());
   root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(b=>b.addEventListener('click',()=>setPreset(b.dataset.period??'7d')));
  form.addEventListener('submit',event=>{event.preventDefault();activeRange='custom';root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(b=>b.setAttribute('aria-pressed','false'));void refresh();});
  exportButton?.addEventListener('click',()=>{
   if(!results.length)return;
   const escapeCsv=(value:string)=>'"'+value.replace(/"/g,'""')+'"';
   const lines=['"veli\u010dina";"konec intervalu UTC";"hodnota";"jednotka";"kvalita";"rozlišení"'];
   for(const result of results)for(const p of result.points){
    lines.push([result.metric,p.endTime,valid(p)?String(p.value):'',units[result.metric]??result.unit,p.quality,result.resolution].map(escapeCsv).join(';'));
   }
   const blob=new Blob(['\ufeff'+lines.join('\r\n')],{type:'text/csv;charset=utf-8'});
   const url=URL.createObjectURL(blob);
   const a=document.createElement('a');a.href=url;a.download='loucka-historie-'+dateInput('from').value+'-'+dateInput('to').value+'.csv';a.click();
   setTimeout(()=>URL.revokeObjectURL(url),1000);
  });
  const themeChanged=()=>void refresh();
  window.addEventListener('loucka:theme-change',themeChanged);
  document.addEventListener('astro:before-swap',()=>{
   controller?.abort();observer.disconnect();chart.dispose();
   window.removeEventListener('loucka:theme-change',themeChanged);
  },{once:true});
  const requestedMetric=new URLSearchParams(location.search).get('metric');
  if(requestedMetric&&[...metricInput('metric').options].some(option=>option.value===requestedMetric))metricInput('metric').value=requestedMetric;
  const requestedDate=new URLSearchParams(location.search).get('date');
  const today=localDate(new Date());
  let validDate=false;
  if(requestedDate&&requestedDate>='2009-01-01'&&requestedDate<=today){try{pragueMidnightIso(requestedDate);validDate=true;}catch{}}
  if(validDate&&requestedDate){
   activeRange='custom';dateInput('from').value=requestedDate;dateInput('to').value=requestedDate;
   root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(b=>b.setAttribute('aria-pressed','false'));void refresh();
  }else setPreset(activeRange);
 }
</script>

