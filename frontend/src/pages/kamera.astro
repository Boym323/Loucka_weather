---
import BaseLayout from '../layouts/BaseLayout.astro';
import OverviewReadings from '../features/current/OverviewReadings.astro';
import CameraArchive from '../features/camera/CameraArchive.astro';
---
<BaseLayout title="Webkamera">
 <div class="page-intro"><span class="eyebrow">Pohled na Loučku a okolí</span><h1>Webkamera Loučka – západ</h1><p>Aktuální snímek západní kamery.</p></div>
 <div class="camera-layout camera-layout-enhanced">
  <section class="section camera-panel" data-camera>
   <div class="section-heading"><h2>Aktuální snímek</h2><span class="status-chip" data-camera-status role="status">Načítám snímek</span></div>
   <div class="camera-image camera-image-large"><img data-camera-image src="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" alt="Pohled webkamery na Loučku západním směrem" /></div>
   <p class="source-note" data-camera-message>Čas pořízení snímku není dostupný.</p>
   <nav class="camera-mode-tabs" aria-label="Dostupné pohledy"><span class="chart-tab is-active">Aktuální snímek</span><a class="chart-tab" href="#camera-archive-title">Archiv snímků</a><a class="chart-tab" href="#camera-archive-title">Časosběr</a></nav>
   <div class="camera-actions">
    <button type="button" class="camera-refresh" data-camera-refresh>↻ Obnovit snímek</button>
    <button type="button" class="chart-tab" data-camera-auto aria-pressed="false">Automatické obnovení: vypnuto</button>
    <button type="button" class="chart-tab" data-camera-fullscreen>Celá obrazovka</button>
    <a class="panel-link" href="https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg" target="_blank" rel="noopener noreferrer">Otevřít originál ↗</a>
   </div>
   <p class="source-note" data-camera-checked>Načtení se ještě neověřilo.</p>
  </section>
  <aside class="camera-sidebar">
   <section class="section camera-info">
    <div class="section-heading"><h2>Informace o kameře</h2><span class="status-chip">Západ</span></div>
    <dl>
     <div><dt>Směr pohledu</dt><dd>Západ</dd></div>
     <div><dt>Zdroj</dt><dd>Počasí Loučka</dd></div>
     <div><dt>Čas pořízení</dt><dd data-camera-captured>Neověřený</dd></div>
     <div><dt>Stáří snímku</dt><dd data-camera-age>Neověřené</dd></div>
     <div><dt>Archiv snímků</dt><dd><a href="#camera-archive-title">Zobrazit galerii</a></dd></div>
    </dl>
    <p class="source-note">Úspěšné načtení fotografie nezaručuje, že jde o čerstvý snímek.</p>
   </section>
   <section class="section camera-direction">
    <h2>Směr pohledu</h2>
    <div class="camera-direction-symbol" aria-hidden="true">← <span>Z</span></div>
    <p class="lead">Kamera sleduje západní směr z oblasti Loučky. Přesnou polohu ani úhel záběru bez ověření nezobrazujeme.</p>
   </section>
   <OverviewReadings />
  </aside>
 </div>
<CameraArchive />
</BaseLayout>
<style>
 .camera-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(220px,1fr);gap:12px;align-items:start}.camera-panel{min-width:0}.camera-actions{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.camera-refresh{padding:8px 12px;color:#052119;background:#43e6ab;border:0;border-radius:6px;font-weight:700}.camera-info dl{margin:12px 0}.camera-info dl div{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding:10px 0;font-size:12px}.camera-info dt{color:var(--muted)}.camera-info dd{margin:0;text-align:right}.camera-panel [data-camera-message]{margin:10px 0}@media(max-width:750px){.camera-layout{grid-template-columns:1fr}}

 .camera-layout-enhanced{grid-template-columns:minmax(0,2.2fr) minmax(250px,.8fr)}
 .camera-sidebar{display:grid;gap:12px;align-content:start}
 .camera-mode-tabs{display:flex;flex-wrap:wrap;gap:7px;margin:13px 0 0}
 .camera-mode-tabs .is-active{background:var(--teal);color:#043328;border-color:var(--teal)}
 .camera-mode-tabs .muted{opacity:.58}
 .camera-direction-symbol{font-size:37px;color:var(--teal);display:flex;align-items:center;justify-content:center;height:80px;font-weight:800}
 .camera-direction-symbol span{font-size:18px;margin-left:10px;color:var(--muted)}
 .camera-archive-note{margin-top:12px}
 .camera-image-large:fullscreen{background:#04121d;display:flex;align-items:center;justify-content:center;padding:12px}
 .camera-image-large:fullscreen img{max-height:100%;max-width:100%;object-fit:contain}
 .camera-actions [aria-pressed="true"]{color:#041b16;background:var(--teal);border-color:var(--teal)}
 .camera-actions{margin-top:12px}
 @media(max-width:900px){.camera-layout-enhanced{grid-template-columns:1fr}.camera-sidebar{grid-template-columns:repeat(2,minmax(0,1fr))}.camera-sidebar .overview-readings{grid-column:1/-1}}
 @media(max-width:650px){.camera-sidebar{grid-template-columns:1fr}.camera-sidebar .overview-readings{grid-column:auto}}
</style>
<script>
 import {getCameraStatus} from '../shared/api/client';
 import {formatTimestamp} from '../shared/domain/weather';
 const root=document.querySelector<HTMLElement>('[data-camera]');
 const img=root?.querySelector<HTMLImageElement>('[data-camera-image]');
 const status=root?.querySelector<HTMLElement>('[data-camera-status]');
 const message=root?.querySelector<HTMLElement>('[data-camera-message]');
 const refresh=root?.querySelector<HTMLButtonElement>('[data-camera-refresh]');
 const auto=root?.querySelector<HTMLButtonElement>('[data-camera-auto]');
 const fullscreen=root?.querySelector<HTMLButtonElement>('[data-camera-fullscreen]');
 const checked=root?.querySelector<HTMLElement>('[data-camera-checked]');
 let timer:number|undefined;
 const checkedFormatter=new Intl.DateTimeFormat('cs-CZ',{timeZone:'Europe/Prague',hour:'2-digit',minute:'2-digit',second:'2-digit'});
 const checkedNow=()=>{if(checked)checked.textContent='Obrázek načten v '+checkedFormatter.format(new Date())+' (čas pořízení fotoaparátem není ověřen).';};
 function reload(){
  if(!img)return;
  if(status){status.textContent='Načítám snímek';status.className='status-chip';}
  img.src='https://webcam.pocasi-loucka.eu/zapadni_kamera.jpg?t='+Date.now();
 }

 function loaded(){if(status){status.textContent='Snímek načten';status.className='status-chip ok';}if(message)message.textContent='Čas pořízení snímku není dostupný.';checkedNow();}
 function failed(){if(status){status.textContent='Kamera nedostupná';status.className='status-chip error';}if(message)message.textContent='Snímek se nepodařilo načíst. Zkuste jej obnovit.';}
 img?.addEventListener('load',loaded);img?.addEventListener('error',failed);
 if(img?.complete){if(img.naturalWidth)loaded();else failed();}
 const metaController=new AbortController();
 void getCameraStatus(metaController.signal).then(info=>{
  const captured=document.querySelector<HTMLElement>('[data-camera-captured]');
  const age=document.querySelector<HTMLElement>('[data-camera-age]');
  if(info.status==='fresh'||info.status==='stale'){
   if(captured)captured.textContent='Neověřený · archiv ukládá čas stažení';
   if(age&&info.ageSeconds!==null)age.textContent='Od stažení '+Math.round(info.ageSeconds/60)+' minut';
   if(status){status.textContent=info.status==='fresh'?'Snímek nedávno stažen':'Starší uložený snímek';status.className='status-chip '+(info.status==='fresh'?'ok':'warning');}
  }
  // The current API explicitly reports disabled; do not imply verified LIVE data.
 }).catch(()=>{});
 refresh?.addEventListener('click',reload);
 auto?.addEventListener('click',()=>{
  if(timer!==undefined){window.clearInterval(timer);timer=undefined;}
  else timer=window.setInterval(()=>{if(document.visibilityState==='visible')reload();},60000);
  if(auto){const enabled=timer!==undefined;auto.setAttribute('aria-pressed',String(enabled));auto.textContent=enabled?'Automatické obnovení: 60 s':'Automatické obnovení: vypnuto';}
 });
 fullscreen?.addEventListener('click',()=>{
  const target=root?.querySelector<HTMLElement>('.camera-image-large');
  if(!target)return;
  if(document.fullscreenElement)void document.exitFullscreen();
  else void target.requestFullscreen().catch(()=>{});
 });
 document.addEventListener('astro:before-swap',()=>{
  metaController.abort();
  if(timer!==undefined)window.clearInterval(timer);
 },{once:true});
</script>
