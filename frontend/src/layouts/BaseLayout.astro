---
import '../styles/global.css';
import '../styles/refinement.css';
import '../styles/atlas-minimal.css';
import '../styles/observatory-evergreen.css';
import '../styles/accessibility.css';
import '../styles/theme-picker.css';
import '../styles/climate-atlas.css';
import '../styles/wind-compass-v2.css';
import DeploymentInfo from '../shared/ui/DeploymentInfo.astro';
import LiveSync from '../shared/ui/LiveSync.astro';
import MobileDock from '../shared/ui/MobileDock.astro';
import SiteIcon from '../shared/ui/SiteIcon.astro';
import ThemePicker from '../shared/ui/ThemePicker.astro';
interface Props { title: string; description?: string }
const { title, description = 'Meteorologická měření ze stanice Počasí Loučka.' } = Astro.props;
const navigation = [
 { href:'/',title:'Přehled' },
 { href:'/aktualne/',title:'Měření' },
 { href:'/grafy/',title:'Grafy' },
 { href:'/klimatologie/',title:'Klimatologie' },
 { href:'/rekordy/',title:'Rekordy' },
 { href:'/senzory/',title:'Senzory' }
];
const secondaryNavigation = [
 { href:'/kamera/',title:'Webkamera' },
 { href:'/mapy/',title:'Radar a mapy' },
 { href:'/puda-ovzdusi/',title:'Půda a ovzduší' },
 { href:'/stav/',title:'Stav stanice' },
 { href:'/o-stanici/',title:'O projektu' }
];
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="cs" data-theme="light">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F6F9FB" />
  <title>{title} | Počasí Loučka</title>
  <script is:inline>
   // Early bootstrap preserves manual choices before the theme module evaluates.
   // Automatic day/night is resolved from Loučka sunrise/sunset by ThemePicker.
   try {
    const choice=localStorage.getItem('loucka-theme');
    const preference=choice==='light'||choice==='dark'?choice:'auto';
    document.documentElement.dataset.themePreference=preference;
    document.documentElement.dataset.theme=preference==='auto'?
     (matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):preference;
   } catch { document.documentElement.dataset.themePreference='auto'; }
  </script>
 </head>
 <body>
  <a class="skip-link" href="#obsah">Přejít k obsahu</a>
  <header class="site-header">
   <div class="wrap header-inner">
    <a class="brand" href="/">
     <span class="brand-symbol" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 5-7 4 4 3-3 6 6"/><path d="M3 19h18"/><path d="M16.5 4.5v3m-1.5-1.5h3"/></svg></span>
     <span class="brand-label"><strong>Počasí Loučka</strong><small>Osobní meteorologická stanice</small></span>
    </a>
    <nav aria-label="Hlavní navigace" class="nav">
     {navigation.map(item => <a href={item.href} aria-current={(active === item.href || (item.href === '/klimatologie/' && active.startsWith('/klimatologie/'))) ? 'page' : undefined}>{item.title}</a>)}
     <details class="atlas-more">
      <summary>Více <SiteIcon name="chevron-down" size={16} /></summary>
      <div class="atlas-more-list">
       {secondaryNavigation.map(item => <a href={item.href} aria-current={(active === item.href || (item.href === '/klimatologie/' && active.startsWith('/klimatologie/'))) ? 'page' : undefined}>{item.title}</a>)}
      </div>
     </details>
    </nav>
    <div class="header-actions">
     <LiveSync />
     <ThemePicker />
     <span class="header-clock" data-prague-clock aria-label="Místní čas v Loučce">--:--</span>
    </div>
    <details class="mobile-nav">
     <summary><SiteIcon name="menu" size={19} /><span>Menu</span></summary>
     <nav aria-label="Mobilní navigace">
      {[...navigation,...secondaryNavigation].map(item => <a href={item.href} aria-current={(active === item.href || (item.href === '/klimatologie/' && active.startsWith('/klimatologie/'))) ? 'page' : undefined}>{item.title}</a>)}
     </nav>
    </details>
   </div>
  </header>
  <main id="obsah" class="wrap content"><slot /></main>
  <MobileDock />
  <footer class="site-footer"><div class="wrap footer-inner"><span>© Počasí Loučka · vývojový náhled</span><DeploymentInfo /><a href="/o-stanici/">O projektu a zdrojích dat</a></div></footer>
  <script>
   const clock=document.querySelector<HTMLElement>('[data-prague-clock]');
   const tick=()=>{if(clock)clock.textContent=new Intl.DateTimeFormat('cs-CZ',{dateStyle:'short',timeStyle:'short',timeZone:'Europe/Prague'}).format(new Date());};
   tick(); setInterval(tick,60_000);
  </script>
 </body>
</html>
