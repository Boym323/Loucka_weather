---
const links=[
 {href:'/',label:'Přehled',icon:'home'},
 {href:'/aktualne/',label:'Měření',icon:'weather'},
 {href:'/grafy/',label:'Grafy',icon:'chart'},
 {href:'/klimatologie/',label:'Historie',icon:'history'}
] as const;
const more=[
 {href:'/rekordy/',label:'Rekordy'},
 {href:'/senzory/',label:'Senzory'},
 {href:'/puda-ovzdusi/',label:'Půda a ovzduší'},
 {href:'/kamera/',label:'Webkamera'},
 {href:'/mapy/',label:'Mapy a radar'},
 {href:'/stav/',label:'Stav stanice'},
 {href:'/o-stanici/',label:'O projektu'}
];
const active=Astro.url.pathname;
---
<nav class="mobile-dock" aria-label="Rychlá mobilní navigace">
 {links.map(link=><a href={link.href} aria-current={active===link.href?'page':undefined}>
  <span class="mobile-dock-icon" aria-hidden="true">
   <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {link.icon==='home'&&<><path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9"/><path d="M10 21v-7h4v7"/></>}
    {link.icon==='weather'&&<><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="5"/><path d="M9 8 7 6M15 16l2 2"/></>}
    {link.icon==='chart'&&<><path d="M3 3v18h18"/><path d="m6 15 4-5 4 3 5-8"/></>}
    {link.icon==='history'&&<><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 14h3M8 17h3"/></>}
   </svg>
  </span>
  <span>{link.label}</span>
 </a>)}
 <details class="atlas-mobile-more">
  <summary aria-label="Další stránky">
   <span class="mobile-dock-icon" aria-hidden="true">
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
   </span>
   <span>Více</span>
  </summary>
  <div class="atlas-mobile-more-menu">
   <strong>Další stránky</strong>
   {more.map(link=><a href={link.href} aria-current={active===link.href?'page':undefined}>{link.label}</a>)}
  </div>
 </details>
</nav>
