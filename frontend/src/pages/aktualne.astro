---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentPanel from '../features/current/CurrentPanel.astro';
import DailySummaryStrip from '../features/current/DailySummaryStrip.astro';
import WindCompass from '../features/current/WindCompass.astro';
import OverviewReadings from '../features/current/OverviewReadings.astro';
import HistoryChart from '../features/history/HistoryChart.astro';
import SensorChannels from '../features/sensors/SensorChannels.astro';
import SensorMiniPanel from '../features/sensors/SensorMiniPanel.astro';
---
<BaseLayout title="Aktuální údaje">
 <div class="page-intro actual-intro">
  <div><span class="eyebrow">GW3000 živě · WeeWX archiv</span><h1>Aktuální údaje</h1><p>Detailní přehled současných meteorologických měření v Loučce.</p></div>
  <span class="status-chip">Živá GW3000 data s archivním záložním zdrojem</span>
 </div>
 <div class="actual-layout">
  <div class="actual-main">
   <CurrentPanel />
   <DailySummaryStrip />
   <div class="actual-wind-row">
    <WindCompass />
    <HistoryChart compact defaultMetric="windGust" />
   </div>
  </div>
  <aside class="actual-side">
   <OverviewReadings />
   <SensorMiniPanel />
  </aside>
 </div>
 <SensorChannels />
</BaseLayout>
