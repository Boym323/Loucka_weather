[Unit]
Description=Loucka warning - verify official CHMI CAP for ORP 7209
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=loucka
Group=loucka
ExecStart=/usr/bin/python3 /usr/local/libexec/loucka-data-collector.py alerts
StateDirectory=loucka-alerts
StateDirectoryMode=0755
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/loucka-alerts
TimeoutStartSec=35
